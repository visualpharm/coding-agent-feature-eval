diff --git a/modules/nimba/estimate-deps.js b/modules/nimba/estimate-deps.js
new file mode 100644
index 0000000..2a8c78d
--- /dev/null
+++ b/modules/nimba/estimate-deps.js
@@ -0,0 +1,79 @@
+'use strict';
+/* Lo que el flujo del chat necesita del resto del sistema, en un solo lugar y
+ * detrás de una interfaz chica, para que los tests inyecten el suyo.
+ *
+ * Nada de esto es propio del chat: es EXACTAMENTE lo que corren
+ * /api/quote/addresses y /api/quote/analysis. Si alguna vez hay que tocar la
+ * fórmula de precio, se toca en lib/pricing.js e installer-pricing.js y este
+ * archivo no cambia. */
+const geocode = require('../../lib/geocode');
+const customerLeads = require('../../lib/customer-leads');
+
+/* homeownerOwner vive en server/server.js (dueño de adquisición). Se pide
+ * tarde para no cerrar el ciclo de require: server carga este módulo. */
+function serverApi() { return require('../../server/server'); }
+
+function build({ req, cfg }) {
+  const owner = serverApi().homeownerOwner(cfg);
+  return {
+    ok: !!owner,
+    async searchAddress(query) {
+      const bias = await geocode.resolveRequestLocationBias({ req, cfg: owner }).catch(() => null);
+      return geocode.searchAddress(query, { cfg: owner, bias });
+    },
+    async createLead({ address, lat, lng, name, email, whatsapp }) {
+      const aerial = require('../../lib/aerial');
+      const imagery = aerial.imageryFor(owner, lat, lng);
+      const propertyContext = await require('../../lib/property-context').resolve(lat, lng).catch(() => null);
+      const country = propertyContext?.country || await geocode.countryForPoint(lat, lng).catch(() => null);
+      const created = await customerLeads.create({ installerId: owner.installerId, source: 'site-chat-estimate', address, lat, lng, imagery, country, propertyContext });
+      /* followupConsent: el visitante pidió el informe en el chat y nos dio el
+       * dato para mandárselo — es el mismo consentimiento explícito que firma
+       * el paso de contacto del asistente. */
+      await customerLeads.setContact(created.id, created.access, { name, email, whatsapp, followupConsent: true, marketingConsent: false });
+      return { lead: customerLeads.get(created.id, created.access), access: created.access };
+    },
+    async runAnalysis({ lead, access, intake }) {
+      const roofInsights = require('../../lib/roof-insights');
+      const { reportAnalysis } = serverApi();
+      const PRICING = require('../../lib/pricing');
+      const country = String(lead.country || 'AR').toUpperCase();
+      const billCurrency = country !== 'AR' ? 'USD' : 'ARS';
+      const gridPricePerKwh = billCurrency === 'ARS' ? PRICING.GRID_PRICE_PER_KWH : null;
+      const monthlyBillLocal = intake.monthlyBill || null;
+      /* Sin consumo declarado, preliminaryQuote arranca del caso residencial
+       * publicado recortado por el techo medido (lib/customer-quote.js): nunca
+       * llenamos un techo grande sólo porque hay superficie. */
+      const monthlyKwh = intake.monthlyKwh
+        || (monthlyBillLocal && gridPricePerKwh ? Math.round(monthlyBillLocal / gridPricePerKwh) : null);
+      const full = {
+        country,
+        monthlyKwh,
+        monthlyBillArs: billCurrency === 'ARS' ? monthlyBillLocal : null,
+        monthlyBillLocal,
+        billCurrency,
+        sourceBillCurrency: billCurrency,
+        gridPriceArsPerKwh: billCurrency === 'ARS' ? PRICING.GRID_PRICE_PER_KWH : null,
+        gridPricePerKwh,
+        consumptionSource: monthlyBillLocal ? 'monthly-bill' : 'unknown',
+        intent: intake.intent,
+        intentOther: '',
+        ownership: intake.ownership,
+        ownershipOther: '',
+        roofEdited: false,
+        panelShiftEastM: 0, panelShiftNorthM: 0, panelRotationDeg: 0,
+        phase: 'unknown', roofType: 'unknown', shade: 'unknown',
+        backup: intake.intent === 'save' ? 'none' : intake.intent === 'backup' ? 'full' : 'essential',
+        newBuild: intake.ownership === 'planning',
+      };
+      let roofStudy = null;
+      try { roofStudy = await roofInsights.studyFor(lead.lat, lead.lng, { owner }); }
+      catch (err) { console.error(`[chat-estimate] roof-insights ${err.message}`); }
+      const analysis = reportAnalysis({ lead, intake: full, roofStudy });
+      await customerLeads.setAnalysis(lead.id, access, { intake: full, invoice: null, panelPhoto: null, analysis, roofStudy });
+      return analysis;
+    },
+  };
+}
+
+module.exports = { build };
