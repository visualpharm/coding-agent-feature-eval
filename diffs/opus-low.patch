+'use strict';
+/* El estimador en forma de conversación (Ivan, 2026-09-07): pedir precio en el
+ * chat tiene que abrir el flujo del asistente, no una lista de planes ni una
+ * oferta de visita, y terminar con el informe en el hilo.
+ *
+ * El geocoder y el modelo se inyectan: la suite nunca sale a la red. El
+ * análisis se inyecta también — la fórmula de precio ya la prueban
+ * customer-quote.test.js y checkout-pricing.test.js; acá se prueba que el
+ * chat la llama con lo que juntó y muestra el informe. */
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+
+process.env.NODE_ENV = 'test';
+process.env.BRUNO_DATA_PACK = 'demo';
+process.env.BRUNO_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), 'bruno-chat-estimate-'));
+delete process.env.OPENROUTER_API_KEY;
+process.env.BRUNO_OPENROUTER_API_KEY = 'test-key-not-real';
+process.env.BRUNO_CHAT_MODEL = 'test/model';
+
+const store = require('../modules/nimba/store');
+const responder = require('../modules/nimba/responder');
+const estimate = require('../modules/nimba/estimate');
+const guardrails = require('../modules/nimba/guardrails');
+
+const ORIGIN = 'https://esun.usabruno.com';
+
+function fakeFetch(replies) {
+  const queue = [...replies];
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push(JSON.parse(init.body));
+    const text = queue.length > 1 ? queue.shift() : queue[0];
+    return { ok: true, status: 200, json: async () => ({ model: 'test/model', choices: [{ message: { content: text } }] }) };
+  };
+  fn.calls = calls;
+  return fn;
+}
+
+/* Las dependencias reales (modules/nimba/estimate-deps.js) en versión falsa:
+ * el geocoder devuelve lo que el caso declara, el lead es de mentira y el
+ * análisis registra la intake que le llegó para poder afirmarla. */
+function fakeDeps({ addresses = null, fail = false } = {}) {
+  const seen = { searches: [], leads: [], intakes: [] };
+  return {
+    seen,
+    ok: true,
+    async searchAddress(query) {
+      seen.searches.push(query);
+      if (fail) throw new Error('geocoder unavailable');
+      if (typeof addresses === 'function') return addresses(query);
+      return addresses || [{ label: 'Avenida Ejemplo 456, Pinamar', lat: -37.1, lng: -56.86 }];
+    },
+    async createLead(input) {
+      seen.leads.push(input);
+      return { lead: { id: 'lead-1', lat: input.lat, lng: input.lng, country: 'AR' }, access: 'acc-1' };
+    },
+    async runAnalysis({ intake }) {
+      seen.intakes.push(intake);
+      return { panels: 14, kwp: 7.7, plans: [
+        { id: 'economico', name: 'Económico', totalUsd: 6200, recommended: false },
+        { id: 'optimo', name: 'Óptimo', totalUsd: 9400, recommended: true },
+      ] };
+    },
+  };
+}
+
+let seq = 0;
+async function open(text, extra = {}) {
+  seq += 1;
+  /* chat-routes fija el idioma del hilo con el primer mensaje; el helper hace
+   * lo mismo para que el flujo en inglés se pruebe como en producción. */
+  return store.recordWebInbound({ whatsapp: '', name: '', text, installerId: 'demo-installer', simulated: true, auto: true, clientId: `c${seq}`, language: guardrails.detectLanguage(text, 'es'), ...extra });
+}
+/* Un turno completo: guarda el mensaje, contesta, persiste el resultado
+ * (incluido el paso del estimador) exactamente como hace chat-routes. */
+async function turn(thread, text, { deps, fetchImpl, visitor = {} } = {}) {
+  const t = await store.appendWebInbound(thread.webToken, { text });
+  const r = await responder.answer({ thread: t, text, visitor, fetchImpl, estimateDeps: deps, origin: ORIGIN });
+  const updated = await store.recordAutoReply(t.id, r);
+  return { thread: { ...updated, webToken: thread.webToken }, r };
+}
+
+const OPENERS = [
+  'quiero instalar solar, cuánto sale?',
+  'cuánto cuesta',
+  'precio para mi casa',
+  'quiero paneles',
+  'how much',
+  'i want to install solar, how much?',
+  'me pasás un presupuesto?',
+];
+
+test('cada apertura de precio entra al flujo y lo primero que pide es la dirección', async () => {
+  for (const opener of OPENERS) {
+    const deps = fakeDeps();
+    const fetchImpl = fakeFetch(['El Económico ronda los USD 6.200 y el Óptimo los USD 9.400. ¿Querés que pasemos a verlo, mañana o tarde?']);
+    const t = await open(opener);
+    const r = await responder.answer({ thread: t, text: opener, fetchImpl, estimateDeps: deps, origin: ORIGIN });
+    assert.equal(r.mode, 'estimate', `"${opener}" no abrió el estimador`);
+    assert.equal(r.estimate.step, 'address');
+    assert.match(r.text, /direcci[óo]n|address/i, `"${opener}" no preguntó la dirección`);
+    assert.doesNotMatch(r.text, /USD|\bplan\b/i, `"${opener}" volcó precios de planes`);
+    assert.doesNotMatch(r.text, /visita|ma[ñn]ana o tarde|morning or afternoon/i, `"${opener}" ofreció una visita`);
+    assert.equal(fetchImpl.calls.length, 0, `"${opener}" gastó el modelo en una pregunta determinista`);
+  }
+});
+
+test('el camino completo termina con el enlace al informe en el hilo', async () => {
+  const deps = fakeDeps();
+  const t0 = await open('quiero instalar solar, cuánto sale?');
+  let cur = { ...(await store.recordAutoReply(t0.id, await responder.answer({ thread: t0, text: t0.messages[0].text, estimateDeps: deps, origin: ORIGIN }))), webToken: t0.webToken };
+  assert.equal(cur.estimate.step, 'address');
+
+  let step = await turn(cur, 'Avenida Ejemplo 456, Pinamar', { deps }); cur = step.thread;
+  assert.equal(cur.estimate.data.address, 'Avenida Ejemplo 456, Pinamar');
+  assert.equal(cur.estimate.step, 'ownership');
+  assert.match(step.r.text, /tuya|alquil/i);
+
+  step = await turn(cur, 'es mía', { deps }); cur = step.thread;
+  assert.equal(cur.estimate.data.ownership, 'owner');
+  assert.equal(cur.estimate.step, 'consumption');
+
+  step = await turn(cur, 'unos 450 kwh por mes', { deps }); cur = step.thread;
+  assert.equal(cur.estimate.data.monthlyKwh, 450);
+  assert.equal(cur.estimate.step, 'goal');
+
+  step = await turn(cur, 'las dos cosas', { deps }); cur = step.thread;
+  assert.equal(cur.estimate.data.intent, 'other');
+  assert.equal(cur.estimate.step, 'name');
+
+  step = await turn(cur, 'Marcela', { deps }); cur = step.thread;
+  assert.equal(cur.estimate.data.name, 'Marcela');
+  assert.equal(cur.estimate.step, 'contact');
+
+  step = await turn(cur, 'marcela@example.com', { deps }); cur = step.thread;
+  assert.equal(cur.estimate.step, 'done');
+  const link = step.r.links[0];
+  assert.match(link.href, /^https:\/\/esun\.usabruno\.com\/quote\/results\/lead-1\?t=acc-1$/);
+  assert.match(step.r.text, /14 paneles/);
+  assert.match(step.r.text, /USD 9\.400/, 'el resumen usa el plan recomendado del análisis');
+  assert.doesNotMatch(step.r.text, /visita/i, 'el informe llega antes que cualquier visita');
+  // el lead se creó con lo que juntó la conversación, sin cuenta ni contraseña
+  assert.deepEqual(deps.seen.leads[0], {
+    address: 'Avenida Ejemplo 456, Pinamar', lat: -37.1, lng: -56.86,
+    name: 'Marcela', email: 'marcela@example.com', whatsapp: '',
+  });
+  assert.equal(deps.seen.intakes[0].monthlyKwh, 450);
+  assert.equal(deps.seen.intakes[0].intent, 'other');
+  assert.equal(deps.seen.intakes[0].ownership, 'owner');
+  // el hilo guarda el enlace para que el visitante lo vuelva a ver
+  const view = store.visitorView(store.getForInstaller('demo-installer', cur.id));
+  assert.equal(view.estimating, false);
+  assert.match(view.messages.at(-1).links[0].href, /\/quote\/results\/lead-1/);
+});
+
+test('"no sé" el consumo no frena el informe: arranca del caso residencial publicado', async () => {
+  const deps = fakeDeps();
+  const t0 = await open('cuánto cuesta');
+  let cur = { ...(await store.recordAutoReply(t0.id, await responder.answer({ thread: t0, text: 'cuánto cuesta', estimateDeps: deps, origin: ORIGIN }))), webToken: t0.webToken };
+  for (const [text, expected] of [['Avenida Ejemplo 456, Pinamar', 'ownership'], ['la alquilo', 'consumption']]) {
+    cur = (await turn(cur, text, { deps })).thread;
+    assert.equal(cur.estimate.step, expected);
+  }
+  const step = await turn(cur, 'no sé', { deps });
+  cur = step.thread;
+  assert.equal(cur.estimate.data.consumptionUnknown, true);
+  assert.equal(cur.estimate.data.monthlyKwh, undefined);
+  assert.equal(cur.estimate.step, 'goal');
+  assert.match(step.r.text, /casa promedio/i);
+  cur = (await turn(cur, 'ahorrar', { deps })).thread;
+  cur = (await turn(cur, 'Diego', { deps })).thread;
+  const done = await turn(cur, '2254 55 66 77', { deps });
+  assert.equal(done.thread.estimate.step, 'done');
+  assert.equal(deps.seen.leads[0].whatsapp, '2254556677');
+  assert.equal(deps.seen.intakes[0].monthlyKwh, null, 'sin consumo declarado el análisis decide, no el chat');
+  assert.equal(deps.seen.intakes[0].consumptionSource, 'unknown');
+});
+
+test('una duda al pasar la contesta el modelo y la pregunta pendiente se repite en el mismo mensaje', async () => {
+  const deps = fakeDeps();
+  const fetchImpl = fakeFetch(['Las baterías cubren cortes de horas, no de días.']);
+  const t0 = await open('quiero paneles');
+  let cur = { ...(await store.recordAutoReply(t0.id, await responder.answer({ thread: t0, text: 'quiero paneles', estimateDeps: deps, origin: ORIGIN }))), webToken: t0.webToken };
+  cur = (await turn(cur, 'Avenida Ejemplo 456, Pinamar', { deps })).thread;
+  assert.equal(cur.estimate.step, 'ownership');
+  const step = await turn(cur, '¿la batería aguanta toda la noche?', { deps, fetchImpl });
+  assert.equal(step.r.mode, 'model');
+  assert.match(step.r.text, /cortes de horas/);
+  assert.match(step.r.text, /tuya|alquil/i, 'la pregunta pendiente vuelve en el mismo mensaje');
+  /* Y el modelo recibe la orden de NO repetirla él: si la hace suya, el
+   * visitante lee la misma pregunta dos veces (visto en la corrida real). */
+  const note = fetchImpl.calls[0].messages.find((m) => /pregunta pendiente/.test(m.content || ''));
+  assert.ok(note, 'el turno lleva la nota de la pregunta pendiente');
+  assert.match(note.content, /NO preguntes nada/);
+  assert.equal(step.thread.estimate.step, 'ownership', 'el flujo no avanzó');
+  // y contestada la pregunta, sigue donde estaba
+  const back = await turn(step.thread, 'sí, es mía', { deps });
+  assert.equal(back.thread.estimate.step, 'consumption');
+});
+
+test('varias direcciones: elige entre tres numeradas y sigue', async () => {
+  const deps = fakeDeps({ addresses: [
+    { label: 'Divisadero 1420, Cariló', lat: -37.1, lng: -56.86 },
+    { label: 'Divisadero 142, Cariló', lat: -37.16, lng: -56.89 },
+    { label: 'Divisadero y Avutarda, Cariló', lat: -37.14, lng: -56.88 },
+    { label: 'Divisadero 14, Ostende', lat: -37.13, lng: -56.87 },
+  ] });
+  const t0 = await open('precio para mi casa');
+  let cur = { ...(await store.recordAutoReply(t0.id, await responder.answer({ thread: t0, text: 'precio para mi casa', estimateDeps: deps, origin: ORIGIN }))), webToken: t0.webToken };
+  const ask = await turn(cur, 'Divisadero, Cariló', { deps });
+  cur = ask.thread;
+  assert.equal(cur.estimate.step, 'address', 'sigue en dirección hasta que elija');
+  assert.equal(cur.estimate.candidates.length, 3, 'a lo sumo tres opciones');
+  assert.match(ask.r.text, /1\. Divisadero 1420, Cariló/);
+  assert.doesNotMatch(ask.r.text, /Ostende/);
+  /* "2" pelado, "la 2", "la segunda" y un trozo del texto son la misma
+   * elección: el visitante contesta como se le canta. */
+  for (const [answer, label] of [['la 1', 'Divisadero 1420, Cariló'], ['la segunda', 'Divisadero 142, Cariló'], ['Avutarda', 'Divisadero y Avutarda, Cariló']]) {
+    assert.equal(estimate.parsePick(answer, cur.estimate.candidates)?.label, label, answer);
+  }
+  const picked = await turn(cur, '2', { deps });
+  assert.equal(picked.thread.estimate.data.address, 'Divisadero 142, Cariló');
+  assert.equal(picked.thread.estimate.data.lat, -37.16);
+  assert.equal(picked.thread.estimate.step, 'ownership');
+});
