index 0000000..6b82fd6
--- /dev/null
+++ b/modules/nimba/estimate.js
@@ -0,0 +1,325 @@
+'use strict';
+/* El estimador en forma de conversación (Ivan, 2026-09-07).
+ *
+ * El producto de Bruno NO es "tres planes de referencia y una visita": es el
+ * informe que arma el asistente en /quote/* — dirección, techo medido, paneles
+ * dibujados sobre la casa y precio. El chat tiene que hacer exactamente eso,
+ * de a una pregunta por mensaje, y terminar mostrando el informe en el hilo.
+ *
+ * Determinista, no "prompt y rezar": una compuerta de intención antes del
+ * modelo (detectIntent) abre el flujo, y el flujo es una máquina de estados
+ * guardada en `thread.estimate = { step, data }`. El modelo sólo redacta lo
+ * que NO es una pregunta del flujo (una duda al pasar, ver responder.js).
+ *
+ * El cálculo nunca es propio: la dirección la resuelve el mismo geocoder que
+ * /api/quote/addresses, el techo el mismo roofInsights, y el precio el mismo
+ * reportAnalysis → lib/pricing.js + lib/installer-pricing.js que usa el
+ * asistente web. Acá no hay ninguna fórmula de precio.
+ *
+ * Juicio explícito: el informe se crea SIN cuenta ni contraseña, a diferencia
+ * de /api/quote/contact. Lo protege el token `?t=` del lead, que es la misma
+ * capacidad que ya protege el informe que se manda por mail. */
+
+const STEPS = ['address', 'ownership', 'consumption', 'goal', 'name', 'contact'];
+
+/* ── 1. La compuerta de intención ──────────────────────────────────────── */
+
+/* Pide precio / cotización / instalar / paneles. Se mira ANTES del modelo:
+ * si acierta, el visitante entra al flujo y nunca ve una lista de planes. */
+const INTENT_RE = [
+  /cu[áa]nto\s+(cuesta|sale|vale|saldr[íi]a|costar[íi]a|me\s+sale)/i,
+  /\bqu[ée]\s+precio\b/i,
+  /\bprecio(s)?\b/i,
+  /\bpresupuest/i,
+  /\bcotiz/i,
+  /\bquiero\s+(instalar|poner|comprar|paneles|placas|energ[íi]a\s+solar|solar)/i,
+  /\bme\s+interesa\s+(instalar|poner|los\s+paneles|la\s+energ[íi]a\s+solar|solar)/i,
+  /\b(instalar|poner)\s+(paneles|placas|solar|energ[íi]a\s+solar)/i,
+  /\bpaneles?\s+(solares?|para\s+mi)/i,
+  /\bhow\s+much\b/i,
+  /\bwhat.{0,12}(cost|price)\b/i,
+  /\bprice\b/i,
+  /\bquote\b/i,
+  /\bestimate\b/i,
+  /\bi\s+want\s+(to\s+install|solar|panels)/i,
+  /\b(install|installing|get)\s+solar\b/i,
+  /\bsolar\s+panels?\b/i,
+];
+function detectIntent(text) {
+  const s = String(text || '');
+  return INTENT_RE.some((re) => re.test(s));
+}
+
+/* ── 2. Copy, una pregunta por mensaje ─────────────────────────────────── */
+
+const COPY = {
+  es: {
+    opening: 'Dale, lo armamos ahora mismo: te damos un informe con los paneles dibujados sobre tu techo y el precio.',
+    address: '¿Cuál es la dirección de la propiedad? Calle, número y localidad.',
+    addressAgain: 'No la encontramos. ¿Me la pasás con calle, número y localidad?',
+    addressPick: (list) => `Encontramos varias. ¿Cuál es?\n${list}`,
+    addressFailed: 'No pudimos buscar la dirección en este momento. ¿Me la repetís en un rato?',
+    ownership: '¿La casa es tuya, la alquilás, o todavía la estás proyectando?',
+    consumption: '¿Cuánto consumís por mes en kWh, o cuánto te viene la factura de luz? Si no lo tenés a mano, decime "no sé".',
+    goal: '¿Qué buscás: ahorrar en la factura, tener respaldo cuando se corta la luz, o las dos cosas?',
+    name: '¿Cómo te llamás?',
+    contact: '¿A qué mail o WhatsApp te mandamos el informe?',
+    contactAgain: 'Ese dato no nos cierra. ¿Me pasás un mail o un WhatsApp con código de área?',
+    working: 'Dame un momento que medimos el techo y armamos el informe.',
+    unknownConsumption: 'Sin problema, arrancamos de una casa promedio y lo ajustamos después.',
+    failed: 'No pudimos terminar el informe ahora. Lo retomamos en un rato y te avisamos acá mismo.',
+    reportLink: 'Ver mi informe',
+    summary: ({ panels, kwp, price, plan }) => `Listo: en tu techo entran ${panels} paneles, ${kwp} kWp.${price ? ` El plan ${plan} sale ${price} y en el informe podés cambiar la cantidad de paneles.` : ''}`,
+  },
+  en: {
+    opening: "Sure, let's build it now: we'll put together a report with the panels drawn on your roof and the price.",
+    address: "What's the address of the property? Street, number and town.",
+    addressAgain: "We couldn't find it. Can you give me street, number and town?",
+    addressPick: (list) => `We found a few. Which one is it?\n${list}`,
+    addressFailed: "We couldn't search the address right now. Can you repeat it in a bit?",
+    ownership: 'Do you own the house, rent it, or are you still planning it?',
+    consumption: "How much do you use per month in kWh, or how much is your electricity bill? If you don't have it handy, just say \"I don't know\".",
+    goal: 'What are you after: saving on the bill, backup when the power goes out, or both?',
+    name: "What's your name?",
+    contact: 'Which email or WhatsApp should we send the report to?',
+    contactAgain: "That doesn't look right. Can you give me an email or a WhatsApp with area code?",
+    working: 'Give us a moment while we measure the roof and build the report.',
+    unknownConsumption: "No problem, we start from an average home and adjust it later.",
+    failed: "We couldn't finish the report right now. We'll pick it up shortly and tell you here.",
+    reportLink: 'See my report',
+    summary: ({ panels, kwp, price, plan }) => `Done: ${panels} panels fit on your roof, ${kwp} kWp.${price ? ` The ${plan} plan is ${price}, and you can change the panel count inside the report.` : ''}`,
+  },
+};
+function copy(language) { return COPY[language === 'en' ? 'en' : 'es']; }
+
+/* ── 3. Lectura de cada respuesta ──────────────────────────────────────── */
+
+/* Sin `\b` al final: "sé" termina en un carácter que JS no cuenta como
+ * palabra, y un límite de palabra ahí nunca casa. */
+const DONT_KNOW = /\b(no\s*s[ée]|ni\s+idea|no\s+tengo\s+idea|no\s+la\s+tengo|no\s+lo\s+s[ée]|dunno|no\s+idea|not\s+sure|don'?t\s+know|do\s+not\s+know)/i;
+
+function parseOwnership(text) {
+  const s = String(text || '');
+  if (/\b(alquil|inquilin|rent|renting|tenant|lease)/i.test(s)) return 'renter';
+  if (/\b(proyect|construy|constru|todav[íi]a\s+no|a\s+futuro|planning|planeando|plan\s+to\s+build|building|future)/i.test(s)) return 'planning';
+  if (/\b(m[íi]a|mio|propia|propio|due[ñn]|soy\s+el\s+due|own|owner|i\s+own|mine|my\s+house)/i.test(s)) return 'owner';
+  if (/\bs[íi]\b|\byes\b/i.test(s)) return 'owner';
+  return null;
+}
+
+/* "300 kwh" → consumo. "$45.000", "45 mil", "45000 por mes" → factura.
+ * Un número pelado sin unidad: hasta 2000 es kWh, más arriba es plata. */
+function parseConsumption(text) {
+  const s = String(text || '');
+  if (DONT_KNOW.test(s)) return { unknown: true };
+  const scaled = s.match(/(\d+(?:[.,]\d+)?)\s*(mil|k)\b/i);
+  const plain = s.match(/(\d[\d.,]*)/);
+  let value = null;
+  if (scaled) value = Math.round(Number(String(scaled[1]).replace(',', '.')) * 1000);
+  else if (plain) {
+    /* 45.000 y 45,000 son miles; 45.5 es un decimal. */
+    const raw = plain[1];
+    const grouped = /^\d{1,3}([.,]\d{3})+$/.test(raw);
+    value = grouped ? Number(raw.replace(/[.,]/g, '')) : Number(raw.replace(',', '.'));
+  }
+  if (!Number.isFinite(value) || value <= 0) return null;
+  const saysKwh = /\bk\s*w\s*h?\b|kilovatios?|kilowatts?/i.test(s);
+  const saysMoney = /[$€]|\bpesos?\b|\bars\b|factura|bill|\bmes\b|month/i.test(s) && !saysKwh;
+  if (saysKwh) return { monthlyKwh: Math.round(value) };
+  if (saysMoney) return { monthlyBill: Math.round(value) };
+  return value <= 2000 ? { monthlyKwh: Math.round(value) } : { monthlyBill: Math.round(value) };
+}
+
+function parseGoal(text) {
+  const s = String(text || '');
+  const save = /\b(ahorr|factura|gastar\s+menos|save|saving|bill|cheaper)/i.test(s);
+  const backup = /\b(cort|respaldo|bater|apag|sin\s+luz|backup|outage|blackout|power\s+cut|battery)/i.test(s);
+  if (/\b(ambas|ambos|las\s+dos|los\s+dos|both|todo)\b/i.test(s) || (save && backup)) return 'other';
+  if (backup) return 'backup';
+  if (save) return 'save';
+  return null;
+}
+
+const EMAIL_RE = /[^\s@]+@[^\s@]+\.[^\s@]{2,}/;
+function parseContact(text) {
+  const s = String(text || '');
+  const email = s.match(EMAIL_RE);
+  if (email) return { email: email[0].toLowerCase() };
+  const digits = (s.match(/[\d+()\-.\s]{8,}/) || [''])[0].replace(/\D/g, '');
+  if (digits.length >= 8 && digits.length <= 15) return { whatsapp: digits };
+  return null;
+}
+
+function parseName(text) {
+  const s = String(text || '').trim().replace(/^(me\s+llamo|soy|mi\s+nombre\s+es|my\s+name\s+is|i'?m|im)\s+/i, '').trim();
+  const clean = s.replace(/[.!¡¿?]+$/, '').slice(0, 80);
+  return clean && clean.split(/\s+/).length <= 6 && /[a-záéíóúñü]/i.test(clean) ? clean : null;
+}
+
+/* Elegir entre las direcciones ofrecidas: "1", "la segunda", o el texto. */
+function parsePick(text, candidates) {
+  const s = String(text || '').trim();
+  /* "1", "la 1", "el 2", "opción 3", "la segunda": el número suelto vale esté
+   * donde esté, no sólo al principio. Un número largo (1420) no es una
+   * elección, es parte de la dirección, y cae en el cotejo por texto. */
+  const n = s.match(/(?:^|\s|\()([123])(?![\d])/) || s.match(/\b(primera|segunda|tercera|first|second|third)\b/i);
+  if (n) {
+    const word = { primera: 1, first: 1, segunda: 2, second: 2, tercera: 3, third: 3 }[String(n[1]).toLowerCase()];
+    const index = (word || Number(n[1])) - 1;
+    if (candidates[index]) return candidates[index];
+  }
+  const lowered = s.toLowerCase();
+  if (lowered.length >= 4) {
+    const hit = candidates.find((c) => String(c.label || '').toLowerCase().includes(lowered));
+    if (hit) return hit;
+  }
+  return null;
+}
+
+/* ── 4. Estado ─────────────────────────────────────────────────────────── */
+
+function blank() { return { step: 'address', data: {}, candidates: [] }; }
+
+/* Lo que ya sabemos del hilo se saltea: no le preguntamos el nombre a alguien
+ * que ya lo escribió en el widget. */
+function seedFrom({ thread = {}, visitor = {} }) {
+  const e = blank();
+  const name = String(visitor.name || thread.name || '').trim();
+  if (name) e.data.name = name;
+  if (thread.verified && thread.whatsapp) e.data.whatsapp = String(thread.whatsapp);
+  if (visitor.email) e.data.email = String(visitor.email);
+  return e;
+}
+
+function pending(estimate) {
+  return STEPS.find((step) => !filled(estimate.data, step)) || null;
+}
+function filled(data, step) {
+  if (step === 'address') return !!data.address;
+  if (step === 'ownership') return !!data.ownership;
+  if (step === 'consumption') return data.monthlyKwh != null || data.monthlyBill != null || data.consumptionUnknown === true;
+  if (step === 'goal') return !!data.intent;
+  if (step === 'name') return !!data.name;
+  if (step === 'contact') return !!(data.email || data.whatsapp);
+  return false;
+}
+
+function questionFor(estimate, language) {
+  const c = copy(language);
+  const step = estimate.step;
+  if (step === 'address' && estimate.candidates && estimate.candidates.length > 1) {
+    return c.addressPick(estimate.candidates.map((x, i) => `${i + 1}. ${x.label}`).join('\n'));
+  }
+  return c[step] || '';
+}
+
+/* ── 5. La máquina ─────────────────────────────────────────────────────── */
+
+/* Lee `text` contra el paso pendiente y devuelve el estado nuevo más lo que
+ * hay que decir. `understood:false` = el visitante no contestó la pregunta
+ * (responder.js manda eso al modelo y después repite la pregunta). */
+async function advance({ estimate, text, language, deps }) {
+  const c = copy(language);
+  const e = { ...estimate, data: { ...estimate.data }, candidates: [...(estimate.candidates || [])] };
+  const step = e.step;
+
+  if (step === 'address') {
+    if (e.candidates.length > 1) {
+      const picked = parsePick(text, e.candidates);
+      if (!picked) return { estimate: e, understood: false };
+      e.data.address = picked.label; e.data.lat = picked.lat; e.data.lng = picked.lng;
+      e.candidates = [];
+    } else {
+      let results;
+      try { results = await deps.searchAddress(text); }
+      catch (err) { return { estimate: e, understood: true, say: c.addressFailed }; }
+      const usable = (results || []).filter((r) => r && Number.isFinite(r.lat) && Number.isFinite(r.lng));
+      if (!usable.length) return { estimate: e, understood: true, say: c.addressAgain };
+      if (usable.length > 1) {
+        e.candidates = usable.slice(0, 3).map((r) => ({ label: r.label || r.address || '', lat: r.lat, lng: r.lng }));
+        return { estimate: e, understood: true, say: c.addressPick(e.candidates.map((x, i) => `${i + 1}. ${x.label}`).join('\n')) };
+      }
+      e.data.address = usable[0].label || usable[0].address || String(text).trim();
+      e.data.lat = usable[0].lat; e.data.lng = usable[0].lng;
+    }
+  } else if (step === 'ownership') {
+    const value = parseOwnership(text);
+    if (!value) return { estimate: e, understood: false };
+    e.data.ownership = value;
+  } else if (step === 'consumption') {
+    const value = parseConsumption(text);
+    if (!value) return { estimate: e, understood: false };
+    if (value.unknown) e.data.consumptionUnknown = true;
+    else Object.assign(e.data, value);
+  } else if (step === 'goal') {
+    const value = parseGoal(text);
+    if (!value) return { estimate: e, understood: false };
+    e.data.intent = value;
+  } else if (step === 'name') {
+    const value = parseName(text);
+    if (!value) return { estimate: e, understood: false };
+    e.data.name = value;
+  } else if (step === 'contact') {
+    const value = parseContact(text);
+    if (!value) return { estimate: e, understood: true, say: c.contactAgain };
+    Object.assign(e.data, value);
+  }
+
+  const next = pending(e);
+  e.step = next || 'done';
+  const prefix = step === 'consumption' && e.data.consumptionUnknown ? `${c.unknownConsumption} ` : '';
+  if (!next) return { estimate: e, understood: true, complete: true };
+  return { estimate: e, understood: true, say: prefix + questionFor(e, language) };
+}
+
+/* ── 6. El informe ─────────────────────────────────────────────────────── */
+
+function money(value, currency = 'USD') {
+  if (!Number.isFinite(Number(value))) return '';
+  return `${currency === 'USD' ? 'USD ' : ''}${Math.round(Number(value)).toLocaleString('es-AR')}`;
+}
+
+/* Crea el lead y corre el MISMO análisis que /api/quote/analysis. Devuelve
+ * { text, links } listos para el hilo, o null si algo falló. */
+async function finish({ estimate, language, deps, origin }) {
+  const c = copy(language);
+  const d = estimate.data;
+  const created = await deps.createLead({
+    address: d.address, lat: d.lat, lng: d.lng,
+    name: d.name, email: d.email || '', whatsapp: d.whatsapp || '',
+  });
+  if (!created) return null;
+  const analysis = await deps.runAnalysis({
+    lead: created.lead, access: created.access,
+    intake: {
+      monthlyKwh: d.monthlyKwh ?? null,
+      monthlyBill: d.monthlyBill ?? null,
+      consumptionSource: d.monthlyKwh != null ? 'monthly-kwh' : d.monthlyBill != null ? 'monthly-bill' : 'unknown',
+      intent: d.intent || 'other',
+      ownership: d.ownership || 'other',
+    },
+  });
+  if (!analysis) return null;
+  const best = bestPlan(analysis);
+  const text = c.summary({
+    panels: analysis.panels,
+    kwp: Number(analysis.kwp).toFixed(1).replace('.', ','),
+    price: best ? money(best.totalUsd) : '',
+    plan: best ? best.name : '',
+  });
+  const href = `${origin}/quote/results/${encodeURIComponent(created.lead.id)}?t=${encodeURIComponent(created.access)}`;
+  return { text, links: [{ label: c.reportLink, href }], leadId: created.lead.id };
+}
+
+/* El plan que mostramos en el resumen: el recomendado si el análisis lo marca,
+ * si no el más barato. Nunca un precio calculado acá. */
+function bestPlan(analysis) {
+  const plans = Array.isArray(analysis && analysis.plans) ? analysis.plans.filter((p) => Number.isFinite(Number(p.totalUsd))) : [];
+  if (!plans.length) return null;
+  return plans.find((p) => p.recommended) || plans.slice().sort((a, b) => Number(a.totalUsd) - Number(b.totalUsd))[0];
+}
+
+module.exports = {
+  STEPS, detectIntent, advance, finish, questionFor, seedFrom, pending, blank, copy,
+  parseOwnership, parseConsumption, parseGoal, parseContact, parseName, parsePick, bestPlan,
+};
