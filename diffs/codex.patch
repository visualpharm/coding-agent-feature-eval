diff --git a/modules/nimba/estimate.js b/modules/nimba/estimate.js
new file mode 100644
index 0000000..bd6b15d
--- /dev/null
+++ b/modules/nimba/estimate.js
@@ -0,0 +1,81 @@
+'use strict';
+// Additive thread state; no account identity is inferred from typed contact data.
+const store = require('./store');
+const fold = s => String(s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
+const wantsEstimate = s => /cuanto (?:cuesta|sale|vale)|precio|presupuesto|cotizame|quiero.*(?:panel|instalar|solar)|how much|\b(?:quote|price|cost|pricing)\b|install.*solar|want.*panels/.test(fold(s));
+const planPrices = s => /(?:precios?.*(?:planes|kits)|(?:plan|kit)s? prices)/i.test(s);
+const questions = {
+ es: {address:'¿Cuál es la dirección de la casa, con localidad?',ownership:'¿Sos dueño, alquilás o estás planeando construir?',consumption:'¿Cuántos kWh consumís por mes o cuánto pagás de luz al mes? Si no sabés, decime «no sé».',intent:'¿Buscás ahorrar, tener respaldo ante cortes o ambos?',name:'¿Cómo te llamás?',contact:'¿Qué email o WhatsApp querés dejar para tu informe?',complete:'¿Querés que volvamos a intentar armar tu informe?'},
+ en: {address:'What is the house address, including the town?',ownership:'Do you own the house, rent it, or plan to build?',consumption:'How many kWh do you use monthly, or how much is your monthly electricity bill? You can say “I don’t know”.',intent:'Are you looking for savings, backup during outages, or both?',name:'What is your name?',contact:'What email or WhatsApp number would you like to use for your report?',complete:'Shall we try generating your report again?'}
+};
+function question(e, lang) {
+ const q = questions[lang === 'en' ? 'en' : 'es'];
+ return e.step === 'choice' ? (lang === 'en' ? 'Which address is yours?\n' : '¿Cuál es tu dirección?\n') + e.matches.map((m,i)=>`${i+1}. ${m.label}`).join('\n') : q[e.step];
+}
+function consumption(text) {
+ const s = fold(text);
+ if (/no se|no tengo|no conozco|don.t know|not sure|unsure/.test(s)) return {monthlyKwh:null, billAnswered:true};
+ if (!/^[\s$\d.,]+(?:\s*(?:mil|k|kwh|pesos|ars|per month|al mes|mensuales))*\s*$/i.test(s)) return null;
+ const raw = s.match(/[\d.,]+/)?.[0]; if (!raw) return null;
+ const n = Number(raw.replace(/[.,](?=\d{3}(?:\D|$))/g,'').replace(',','.')) * (/\bmil\b|\d\s*k\b/.test(s) ? 1000 : 1);
+ if (!(n > 0 && n <= 1e9)) return null;
+ return {billAnswered:true, ...(/kwh/.test(s) ? {monthlyKwh:n} : {monthlyBillLocal:n})};
+}
+async function generate(e, thread, owner, deps = {}) {
+ const leads = require('../../lib/customer-leads');
+ const d=e.data;
+ if (!e.lead) {
+  const imagery = require('../../lib/aerial').imageryFor(owner,d.lat,d.lng);
+  const propertyContext = await require('../../lib/property-context').resolve(d.lat,d.lng).catch(()=>null);
+  const country = propertyContext?.country || await require('../../lib/geocode').countryForPoint(d.lat,d.lng).catch(()=>null);
+  const created = await leads.create({installerId:thread.installerId,source:'site-chat',address:d.address,lat:d.lat,lng:d.lng,imagery,country,propertyContext,newBuild:d.ownership==='planning',simulated:thread.simulated});
+  e.lead = {id:created.id,access:created.access};
+  await store.setEstimate(thread.id,e);
+ }
+ const {id,access}=e.lead;
+ await leads.setContact(id,access,{name:d.name,email:d.email||'',whatsapp:d.whatsapp||'',followupConsent:false,marketingConsent:false});
+ await leads.setConversationModeById(id,true);
+ const lead=leads.get(id,access);
+ const energy=require('../../data/energy-prices').energyFor(lead.country);
+ const billCurrency=lead.country && lead.country!=='AR' ? energy?.currency || 'USD' : 'ARS';
+ const gridPricePerKwh=billCurrency==='ARS' ? require('../../lib/pricing').GRID_PRICE_PER_KWH : energy?.pricePerKwh;
+ const intake={...d,country:lead.country||'AR',billCurrency,monthlyBillArs:billCurrency==='ARS'?d.monthlyBillLocal:null,gridPricePerKwh,gridPriceArsPerKwh:billCurrency==='ARS'?gridPricePerKwh:null,monthlyKwh:d.monthlyKwh || (d.monthlyBillLocal && gridPricePerKwh ? Math.round(d.monthlyBillLocal/gridPricePerKwh):null),consumptionSource:d.monthlyBillLocal?'monthly-bill':'unknown',backup:d.intent==='save'?'none':d.intent==='backup'?'full':'essential',phase:'unknown',roofType:'unknown',shade:'unknown',newBuild:d.ownership==='planning'};
+ const roofStudy=await (deps.studyFor || require('../../lib/roof-insights').studyFor)(d.lat,d.lng,{owner}).catch(()=>null);
+ const analysis=(deps.reportAnalysis || require('../../server/server').reportAnalysis)({lead,intake,roofStudy});
+ await leads.setAnalysis(id,access,{intake,analysis,roofStudy});
+ return {id,access,analysis};
+}
+async function turn({thread,text,visitor={},language='es',owner,origin,deps={}}) {
+ if (!thread.estimate && (!wantsEstimate(text)||planPrices(text))) return null;
+ if (thread.estimate?.step==='done') return null;
+ const fresh=!thread.estimate;
+ const e=structuredClone(thread.estimate || {step:'address',data:{name:visitor.name||thread.name||'',whatsapp:thread.verified?thread.whatsapp:''}});
+ e.origin = origin || e.origin;
+ const d=e.data, s=fold(text);
+ let accepted=false;
+ if (e.step==='choice') {const n=Number(text.trim()); if(n>=1&&n<=e.matches.length){Object.assign(d,{address:e.matches[n-1].label,lat:e.matches[n-1].lat,lng:e.matches[n-1].lng});delete e.matches;e.step="address";accepted=true;}}
+ else if(e.step==='address' && (!fresh || /\d/.test(text))) {
+  if (!/\?|\b(?:warranty|garantia|batteries|baterias|password)\b/.test(s)) {
+   try {const matches=(await (deps.searchAddress||require('../../lib/geocode').searchAddress)(text,{cfg:owner})).filter(m=>Number.isFinite(m.lat)&&Number.isFinite(m.lng)).slice(0,3);
+    if(matches.length===1){Object.assign(d,{address:matches[0].label,lat:matches[0].lat,lng:matches[0].lng});accepted=true;}
+    else if(matches.length>1){e.matches=matches;e.step='choice';accepted=true;}
+   } catch {return {estimate:e,text:language==='en'?'Address lookup is unavailable. Please try the address again.':'No pudimos buscar la dirección. Probá escribirla de nuevo.'};}
+  }
+ } else if(e.step==='ownership') {const v=/dueno|propietari|\bown\b|owner/.test(s)?'owner':/alquil|inquilin|rent/.test(s)?'renter':/constru|planning|plan to build/.test(s)?'planning':null;if(v){d.ownership=v;accepted=true;}}
+ else if(e.step==='consumption'){const v=consumption(text);if(v){Object.assign(d,v);accepted=true;}}
+ else if(e.step==='intent'){const v=/ambos|both/.test(s)?'other':/ahorr|sav/.test(s)?'save':/corte|respaldo|backup|outage/.test(s)?'backup':null;if(v){d.intent=v;accepted=true;}}
+ else if(e.step==='name' && /^[\p{L}][\p{L} .'-]{1,100}$/u.test(text) && !/\?|what|como|garantia|warranty/.test(s)){d.name=text.trim().replace(/^(?:me llamo|soy|my name is) /i,'');accepted=true;}
+ else if(e.step==='contact'){const email=text.trim();const phone=text.replace(/\D/g,'');if(/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){d.email=email;accepted=true;}else if(/^[+\d\s()-]+$/.test(text)&&phone.length>=10&&phone.length<=15){d.whatsapp=phone;accepted=true;}}
+ if(e.step!=='choice')e.step=!d.address?'address':!d.ownership?'ownership':!d.billAnswered?'consumption':!d.intent?'intent':!d.name?'name':!(d.email||d.whatsapp)?'contact':'complete';
+ if(e.step==='complete') {
+  await store.setEstimate(thread.id,e);
+  try {
+   await store.recordOutbound(thread.id,{text:language==='en'?'We’re putting your report together…':'Estoy armando tu informe…',channel:'web',auto:true,by:'Bruno (auto)'});
+   const result=await (deps.generate||generate)(e,thread,owner,deps);e.step='done';e.result={id:result.id,access:result.access};
+   const a=result.analysis,p=a.plans.find(p=>p.recommended)||a.plans[0];const price=Math.round(p.totalUsd).toLocaleString(language==='en'?'en-US':'es-AR');
+   return {estimate:e,text:language==='en'?`Your estimate is ${a.panels} panels (${a.kwp} kWp), with the recommended plan at US$${price}. Your report shows the roof layout and pricing.`:`Tu estimación es de ${a.panels} paneles (${a.kwp} kWp), con el plan recomendado a US$${price}. En tu informe podés ver la distribución en el techo y los precios.`,links:[{label:language==='en'?'View my report':'Ver mi informe',href:`${e.origin}/quote/results/${result.id}?t=${encodeURIComponent(result.access)}`}]};
+  } catch(err) {console.warn('[chat-estimate] analysis unavailable:',err.name);return {estimate:e,text:language==='en'?'We couldn’t finish your report. Say “retry” to try again.':'No pudimos terminar tu informe. Decime «reintentar» para probar de nuevo.'};}
+ }
+ return {estimate:e,text:question(e,language),interrupted:!fresh&&!accepted};
+}
+module.exports={turn,wantsEstimate,question,consumption,generate};
