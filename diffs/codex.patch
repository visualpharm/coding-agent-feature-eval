+ const t=await open();await say(t,'cuánto cuesta');await say(t,'123 Example Street');await say(t,'soy dueño');await say(t,bill);await say(t,'ambos');await say(t,'Ana Demo');
+ const r=await say(t,'ana@example.com',{generate:async(e,t,o)=>{
+ // Exercise real lead/contact/analysis stores and server report analysis; isolate external geography.
+ const leads=require('../lib/customer-leads');const c=await leads.create({installerId:t.installerId,address:location.label,lat:location.lat,lng:location.lng,country:'AR'});
+ e.lead={id:c.id,access:c.access};
+ return estimate.generate(e,t,o,{studyFor:async()=>null});
+ }});
+ assert.equal(r.estimate.step,'done');assert.match(r.links[0].href,/^https:\/\/solar.example\/quote\/results\/.*\?t=/);
+ const lead=require('../lib/customer-leads').get(r.estimate.result.id,r.estimate.result.access);assert.ok(lead.analysis.panels>0);assert.equal(lead.contact.followupConsent,false);assert.equal(lead.intake.monthlyKwh,bill==='300 kwh'?300:null);
+ assert.equal(require('../lib/customer-leads').get(lead.id,'wrong'),null);
+});
