+ const t=await open('en',{name:'Alex',whatsapp:'5491100000000'});await say(t,'how much');const r=await say(t,'Example Street',{searchAddress:async()=>[location,{...location,label:'456 Other Street'},location,location]});assert.equal(r.estimate.matches.length,3);assert.equal(r.estimate.step,'choice');
+ await say(t,'2');const interrupted=await say(t,'What warranty do you offer?');assert.equal(interrupted.estimate.step,'ownership');assert.match(interrupted.text,/own the house/);
+ await say(t,'I own it');await say(t,"I don't know");const contact=await say(t,'both');assert.equal(contact.estimate.step,'contact','unverified phone is not reused');
+});
+test('bill parsing',()=>{assert.equal(estimate.consumption('$45.000').monthlyBillLocal,45000);assert.equal(estimate.consumption('45 mil').monthlyBillLocal,45000);assert.equal(estimate.consumption('300 kwh').monthlyKwh,300);});
+
+test('an interruption calls the stubbed LLM and repeats the pending question',async()=>{
+ process.env.BRUNO_OPENROUTER_API_KEY='test-key-not-real';
+ const t=await open('en');await say(t,'how much');await say(t,'123 Example Street');
+ let calls=0;
+ const current=store.getForInstaller(t.installerId,t.id);
+ const r=await answer({thread:current,text:'What warranty do you offer?',owner,origin:'https://solar.example',fetchImpl:async()=>{calls++;return {ok:true,json:async()=>({choices:[{message:{content:'We can confirm the equipment warranty for your system.'}}]})};}});
+ assert.equal(calls,1);assert.match(r.text,/warranty/);assert.match(r.text,/own the house/);assert.equal(r.estimate.step,'ownership');
+ delete process.env.BRUNO_OPENROUTER_API_KEY;
+});
+
+test('verified name and phone skip contact, and opener can supply the address',async()=>{
