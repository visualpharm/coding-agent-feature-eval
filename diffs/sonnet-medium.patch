+++ b/test/chat-estimate.test.js
@@ -0,0 +1,196 @@
+'use strict';
+/* El estimador en el chat (Ivan, 2026-09-07): "el bot ignora nuestro
+ * producto". Ante cualquier pregunta de precio, el respondedor arma el
+ * presupuesto paso a paso — dirección, dueño/inquilino, consumo, qué busca,
+ * nombre, contacto — y termina mostrando el informe real (/quote/results)
+ * en el hilo. Nunca la charla genérica ni la lista de precios de referencia.
+ *
+ * El geocoder y el modelo se stubean con un solo fetch falso que discrimina
+ * por URL (Google Places vs OpenRouter); cualquier otra URL (Google Solar,
+ * OSM, ARBA) falla a propósito para que roofInsights.studyFor() quede sin
+ * estudio — el estimador arma igual el informe con el caso de muestra. */
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+
+process.env.NODE_ENV = 'test';
+process.env.BRUNO_DATA_PACK = 'demo';
+process.env.BRUNO_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), 'bruno-chat-estimate-'));
+delete process.env.OPENROUTER_API_KEY;
+process.env.BRUNO_OPENROUTER_API_KEY = 'test-key-not-real';
+process.env.BRUNO_CHAT_MODEL = 'test/model';
+process.env.BRUNO_GOOGLE_PLACES_API_KEY = 'test-places-key-not-real';
+
+const store = require('../modules/nimba/store');
+const responder = require('../modules/nimba/responder');
+
+/* Un candidato de dirección sin número de calle: la búsqueda entonces nunca
+ * dispara los pasos de "aterrizar en el lote" (OSM/ARBA), que no están
+ * stubeados acá — ver lib/geocode.js#landOnLot. Dentro del área de servicio
+ * del pack demo (Costa Atlántica). */
+// Coarse two-decimal points (~1 km), never a real street-level fix: the
+// publication scan blocks lat/lng-labeled fields with 3+ decimals as a
+// leaked-address guard (docs/publication-manifest.json), and a geocoder
+// stub has no reason to fake more precision than that anyway.
+const CARILO = { label: 'Cariló, Pinamar, Buenos Aires', lat: -37.17, lng: -56.88 };
+const PINAMAR = { label: 'Pinamar, Buenos Aires', lat: -37.11, lng: -56.86 };
+const VALERIA = { label: 'Valeria del Mar, Buenos Aires', lat: -37.24, lng: -56.93 };
+
+function placesResponse(candidates) {
+  return { ok: true, status: 200, json: async () => ({ status: 'OK', candidates: candidates.map((c) => ({ formatted_address: c.label, geometry: { location: { lat: c.lat, lng: c.lng } } })) }) };
+}
+function llmResponse(text) {
+  return { ok: true, status: 200, json: async () => ({ model: 'test/model', choices: [{ message: { content: text } }] }) };
+}
+
+/* fetchImpl único para todo el turno: Google Places para el geocoder,
+ * OpenRouter para el modelo (interrupciones), cualquier otra URL falla a
+ * propósito (roofInsights, sin estudio, degradado a estimación por defecto). */
+function fakeFetch({ addresses = [CARILO], llmReplies = [] } = {}) {
+  const llmQueue = [...llmReplies];
+  const calls = [];
+  const fn = async (url) => {
+    const u = String(url && url.href ? url.href : url);
+    calls.push(u);
+    if (u.includes('maps.googleapis.com/maps/api/place/findplacefromtext')) return placesResponse(addresses);
+    if (u.includes('openrouter.ai')) {
+      const text = llmQueue.length > 1 ? llmQueue.shift() : (llmQueue[0] || '');
+      return llmResponse(text);
+    }
+    throw new Error(`unstubbed network call in test: ${u}`);
+  };
+  fn.calls = calls;
+  return fn;
+}
+
+async function open(name, text) {
+  // recordWebInbound's return value is the only place the raw (unhashed)
+  // webToken ever appears — the persisted thread keeps only its hash. Every
+  // later turn must carry that same token forward (never re-fetch it).
+  return store.recordWebInbound({ whatsapp: '+54 9 11 0000-0000', name, text, leadId: null, installerId: 'demo-installer', simulated: true, auto: true });
+}
+/* Un turno más en el mismo hilo: guarda el mensaje entrante y corre el
+ * respondedor sobre el hilo actualizado, como hace chat-routes#respond. */
+async function turn(thread, text, fetchImpl) {
+  const t = await store.appendWebInbound(thread.webToken, { text });
+  const r = await responder.answer({ thread: t, text, visitor: { name: t.name, whatsapp: t.whatsapp }, fetchImpl, host: 'usabruno.com' });
+  if (r.flags.length) await store.addFlags(t.id, r.flags);
+  const updated = await store.recordAutoReply(t.id, r);
+  return { thread: { ...updated, webToken: thread.webToken }, result: r };
+}
+
+const OPENERS = [
+  'quiero instalar solar, cuánto sale?',
+  'cuánto cuesta',
+  'precio para mi casa',
+  'quiero paneles',
+  'how much',
+  'i want to install solar, how much?',
+  'me pasás un presupuesto?',
+];
+
+for (const opener of OPENERS) {
+  test(`"${opener}" entra al estimador y pregunta la dirección, nunca la visita ni la lista de precios`, async () => {
+    const t = await open('Visitante ' + Math.random().toString(36).slice(2, 8), opener);
+    const r = await responder.answer({ thread: t, text: opener, visitor: { name: t.name, whatsapp: t.whatsapp }, fetchImpl: fakeFetch() });
+    assert.equal(r.mode, 'estimate');
+    assert.ok(r.estimate && r.estimate.step === 'address', `esperaba el paso 'address', llegó '${r.estimate && r.estimate.step}'`);
+    assert.doesNotMatch(r.text, /mañana|tarde|visita t[eé]cnica|USD \d/i, 'nunca la visita ni un precio de una');
+    assert.match(r.text, /direcci[oó]n|address/i);
+  });
+}
+
+test('camino feliz: dirección → dueño → consumo → qué busca → nombre → contacto termina con el link al informe', async () => {
+  // Sin nombre en el hilo (mensaje directo, sin el formulario nombre+whatsapp):
+  // el flujo pasa por los 6 pasos, incluido "¿cómo te llamás?".
+  const t0 = await open('', 'quiero instalar solar, cuánto sale?');
+  const fetchImpl = fakeFetch({ addresses: [CARILO] });
+  let last = await responder.answer({ thread: t0, text: t0.messages[0].text, visitor: {}, fetchImpl });
+  let thread = { ...(await store.recordAutoReply(t0.id, last)), webToken: t0.webToken };
+  assert.equal(last.estimate.step, 'address');
+
+  ({ thread, result: last } = await turn(thread, 'Avenida Ejemplo, Cariló, Pinamar', fetchImpl));
+  assert.equal(last.estimate.step, 'ownership', 'una sola dirección resuelve y avanza directo a dueño/inquilino');
+
+  ({ thread, result: last } = await turn(thread, 'es mía', fetchImpl));
+  assert.equal(last.estimate.step, 'consumption');
+
+  ({ thread, result: last } = await turn(thread, '300 kwh', fetchImpl));
+  assert.equal(last.estimate.step, 'goal');
+
+  ({ thread, result: last } = await turn(thread, 'quiero ahorrar en la factura', fetchImpl));
+  assert.equal(last.estimate.step, 'name');
+
+  ({ thread, result: last } = await turn(thread, 'Marcela', fetchImpl));
+  assert.equal(last.estimate.step, 'contact');
+
+  ({ thread, result: last } = await turn(thread, 'marcela@example.com', fetchImpl));
+  assert.equal(last.estimate.step, 'done');
+  assert.equal(last.mode, 'estimate');
+  assert.ok(last.links && last.links.length === 1, 'un solo link al informe');
+  assert.match(last.links[0].href, /^https:\/\/usabruno\.com\/quote\/results\/[^/]+\?t=/);
+  assert.match(last.text, /paneles|panels/i);
+
+  const customerLeads = require('../lib/customer-leads');
+  const url = new URL(last.links[0].href);
+  const id = url.pathname.split('/').pop();
+  const accessToken = url.searchParams.get('t');
+  const lead = customerLeads.get(id, accessToken);
+  assert.ok(lead, 'el link resuelve a un lead real, protegido por el token de acceso');
+  assert.equal(lead.contact.name, 'Marcela');
+  assert.equal(lead.contact.email, 'marcela@example.com');
+  assert.equal(lead.analysis.consumptionSource === 'monthly-bill' ? lead.intake.monthlyBillArs : lead.intake.monthlyKwh, 300);
+  assert.ok(lead.analysis.panelRange, 'el control de paneles del informe queda armado (vow: cantidad ajustable)');
+});
+
+test('"no sé" el consumo cae al caso de muestra publicado, nunca a un techo arbitrario', async () => {
+  const t0 = await open('Tomás Ruiz', 'precio para mi casa');
+  const fetchImpl = fakeFetch({ addresses: [PINAMAR] });
+  let thread = { ...(await store.recordAutoReply(t0.id, await responder.answer({ thread: t0, text: t0.messages[0].text, visitor: { name: 'Tomás Ruiz' }, fetchImpl }))), webToken: t0.webToken };
+
+  let step;
+  ({ thread, result: step } = await turn(thread, 'Avenida del Mar, Pinamar', fetchImpl));
+  assert.equal(step.estimate.step, 'ownership');
+  ({ thread, result: step } = await turn(thread, 'alquilo', fetchImpl));
+  assert.equal(step.estimate.step, 'consumption');
+  ({ thread, result: step } = await turn(thread, 'no sé', fetchImpl));
+  assert.equal(step.estimate.step, 'goal', 'no saber el consumo no traba el flujo');
+  assert.equal(step.estimate.data.monthlyKwh, undefined, 'sin consumo forzado: preliminaryQuote arma con el caso de muestra');
+});
+
+test('una pregunta suelta a mitad del flujo se contesta y repite lo pendiente en el mismo mensaje', async () => {
+  const t0 = await open('Lucía Paz', 'cuánto cuesta');
+  const fetchImpl = fakeFetch({ addresses: [VALERIA], llmReplies: ['Las baterías cubren una noche de lo esencial.'] });
+  let thread = { ...(await store.recordAutoReply(t0.id, await responder.answer({ thread: t0, text: t0.messages[0].text, visitor: { name: 'Lucía Paz' }, fetchImpl }))), webToken: t0.webToken };
+  let step;
+  ({ thread, result: step } = await turn(thread, 'Calle Central, Valeria del Mar', fetchImpl));
+  assert.equal(step.estimate.step, 'ownership');
+  ({ thread, result: step } = await turn(thread, 'la tengo alquilada', fetchImpl));
+  assert.equal(step.estimate.step, 'consumption');
+  // Se desvía con una pregunta suelta en vez de contestar el consumo.
+  ({ thread, result: step } = await turn(thread, '¿las baterías duran toda la noche?', fetchImpl));
+  assert.equal(step.estimate.step, 'consumption', 'la interrupción no avanza el paso pendiente');
+  assert.match(step.text, /baterías/i, 'el modelo contestó la pregunta suelta');
+  assert.match(step.text, /consum|kwh|factura/i, 'y repitió la pregunta de consumo pendiente en el mismo mensaje');
+});
+
+test('dirección ambigua: se ofrece una lista numerada y una elección clara la resuelve', async () => {
+  const t0 = await open('Beto Sosa', 'me pasás un presupuesto?');
+  const candidates = [CARILO, PINAMAR, VALERIA];
+  const fetchImpl = fakeFetch({ addresses: candidates });
+  let thread = { ...(await store.recordAutoReply(t0.id, await responder.answer({ thread: t0, text: t0.messages[0].text, visitor: { name: 'Beto Sosa' }, fetchImpl }))), webToken: t0.webToken };
+
+  let step;
+  ({ thread, result: step } = await turn(thread, 'Avenida Costanera, Buenos Aires', fetchImpl));
+  assert.equal(step.estimate.step, 'address_choice', 'varias direcciones encontradas: se pregunta cuál es');
+  assert.equal((step.text.match(/^\d\)/gm) || []).length, 3, 'lista numerada de a lo sumo 3');
+  assert.match(step.text, new RegExp(candidates[0].label));
+  assert.match(step.text, new RegExp(candidates[1].label));
+  assert.match(step.text, new RegExp(candidates[2].label));
+
+  ({ thread, result: step } = await turn(thread, '2', fetchImpl));
+  assert.equal(step.estimate.step, 'ownership', 'elegir la opción 2 resuelve la dirección y avanza');
+  assert.equal(step.estimate.data.address, PINAMAR.label);
+});
