diff --git a/modules/nimba/estimate.js b/modules/nimba/estimate.js
new file mode 100644
index 0000000..f5905b6
--- /dev/null
+++ b/modules/nimba/estimate.js
@@ -0,0 +1,339 @@
+'use strict';
+/* El estimador en el chat (Ivan, 2026-09-07): "el bot ignora nuestro
+ * producto". Bruno NO es un instalador que ofrece una visita — es el
+ * cotizador de IA del wizard (/quote/*) en forma de conversación. Ante
+ * cualquier pregunta de precio, este módulo toma la posta ANTES del modelo:
+ * un dato por mensaje (dirección, dueño/inquilino, consumo, qué busca,
+ * nombre, contacto), y al final crea el mismo lead que crea el wizard y
+ * cotiza con la MISMA función (lib/quote-report-analysis, extraída de
+ * server/server.js) — nunca una fórmula de precio propia del chat.
+ *
+ * El estado del flujo vive en thread.estimate = { step, data }, persistido
+ * por store.js (recordAutoReply). Sin clave de geocoder o de visión el
+ * estimador igual completa: el lead queda armado sin el estudio de techo
+ * (roofStudy null → preliminaryQuote arma con el caso de muestra publicado).
+ *
+ * NUNCA toca modules/nimba/widget.js ni support-copy.js (son de otra rama en
+ * curso): toda la copia de este flujo vive acá, aparte. */
+const customerLeads = require('../../lib/customer-leads');
+const { preliminaryQuote } = require('../../lib/customer-quote');
+const { reportAnalysis } = require('../../lib/quote-report-analysis');
+const roofInsights = require('../../lib/roof-insights');
+const roofVisionEstimator = require('../../lib/roof-vision-estimator');
+const geocode = require('../../lib/geocode');
+const whatsapp = require('../../lib/whatsapp');
+const PRICING = require('../../lib/pricing');
+
+const STEPS = ['address', 'address_choice', 'ownership', 'consumption', 'goal', 'name', 'contact', 'done'];
+const EMAIL_RE = /^\S+@\S+\.\S+$/;
+
+/* Ante cuál pregunta el estimador toma la posta: precio, presupuesto,
+ * cotización, "quiero instalar/paneles/solar", y el inglés equivalente.
+ * Deliberadamente amplio — Human Rounds: mejor un falso positivo (el modelo
+ * igual puede seguir si el visitante sólo preguntaba otra cosa) que dejar
+ * pasar "cuánto sale" a la charla genérica de siempre. */
+const INTENT_RE = /\b(cu[aá]nto (me )?(sale|cuesta|vale|saldr[ií]a)|precio|presupuesto|quiero (instalar|poner|paneles|solar)|me interesa (instalar|poner|paneles|solar)|instalar solar|poner paneles|paneles solares|how much|get a quote|solar quote|solar price|want (solar|panels)|install solar)\b/i;
+
+/* Detecta que el mensaje es una pregunta suelta (no una respuesta al paso
+ * en curso): el estimador la contesta con el modelo y repite lo pendiente,
+ * en vez de trabarse pidiendo lo mismo de nuevo. */
+const QUESTION_RE = /\?|^(qu[eé]|c[oó]mo|cu[aá]ndo|por qu[eé]|cu[aá]nto tarda|d[oó]nde|what|how|when|why|does|do you|is it|can you)\b/i;
+
+function detectsIntent(text) { return INTENT_RE.test(String(text || '')); }
+function isInterruption(text) { return QUESTION_RE.test(String(text || '').trim()); }
+
+function normalizeEstimate(raw) {
+  if (!raw || typeof raw !== 'object' || !STEPS.includes(raw.step)) return { step: 'address', data: {} };
+  return { step: raw.step, data: raw.data && typeof raw.data === 'object' ? raw.data : {} };
+}
+
+/* AR-style number: "45.000" (punto de miles), "45,50" (coma decimal), "45 mil". */
+function parseArNumber(raw) {
+  const s = String(raw || '').trim();
+  const mil = s.match(/^(\d+(?:[.,]\d+)?)\s*mil$/i);
+  if (mil) return Math.round(parseFloat(mil[1].replace(',', '.')) * 1000);
+  if (/^\d{1,3}(\.\d{3})+(,\d+)?$/.test(s)) return Math.round(parseFloat(s.replace(/\./g, '').replace(',', '.')));
+  if (/^\d+,\d{1,2}$/.test(s)) return Math.round(parseFloat(s.replace(',', '.')));
+  const n = parseFloat(s.replace(/,/g, ''));
+  return Number.isFinite(n) ? Math.round(n) : null;
+}
+
+function parseConsumption(text) {
+  const t = String(text || '').trim();
+  if (/no\s*s[eé](\b|$)|ni\s*idea|no\s*tengo\s*idea|not\s*sure|no\s*idea|dont'?\s*know|don'?t\s*know|unsure/i.test(t)) return { unknown: true };
+  const kwh = t.match(/(\d+(?:[.,]\d+)?)\s*k\s?w\s?h/i);
+  if (kwh) {
+    const n = Math.round(parseFloat(kwh[1].replace(',', '.')));
+    if (n > 0) return { monthlyKwh: n };
+  }
+  const mil = t.match(/(\d+(?:[.,]\d+)?)\s*mil\b/i);
+  if (mil) return { monthlyBillArs: Math.round(parseFloat(mil[1].replace(',', '.')) * 1000) };
+  const money = t.match(/\$?\s*(\d{1,3}(?:[.,]\d{3})+|\d{2,7})/);
+  if (money) {
+    const n = parseArNumber(money[1]);
+    if (Number.isFinite(n) && n > 0) {
+      const hasCurrency = /\$|pesos?|\bars\b/i.test(t);
+      return hasCurrency || n >= 3000 ? { monthlyBillArs: n } : { monthlyKwh: n };
+    }
+  }
+  return null;
+}
+
+function parseOwnership(text) {
+  const t = String(text || '').toLowerCase();
+  if (/du[eñ]|propietari|owner|es m[ií]a|own(ed)?\b/.test(t)) return 'owner';
+  if (/alquil|inquilin|rent(er|ing)?\b/.test(t)) return 'renter';
+  if (/construy|construc|voy a construir|build(ing)?\b|planning/.test(t)) return 'planning';
+  if (isInterruption(t)) return null;
+  return 'other';
+}
+
+function parseGoal(text) {
+  const t = String(text || '').toLowerCase();
+  const save = /ahorr|reduci|save|lower/.test(t);
+  const backup = /respaldo|corte|apag[oó]n|sin luz|outage|backup|blackout/.test(t);
+  if (save && backup) return 'both';
+  if (/ambos|los dos|both/.test(t)) return 'both';
+  if (backup) return 'backup';
+  if (save) return 'save';
+  if (isInterruption(t)) return null;
+  return 'both';
+}
+
+function parseContact(text) {
+  const t = String(text || '').trim();
+  if (EMAIL_RE.test(t)) return { method: 'email', value: t.toLowerCase().slice(0, 254) };
+  const wa = whatsapp.toWaId(t);
+  if (wa.length >= 10) return { method: 'whatsapp', value: t.slice(0, 60) };
+  return null;
+}
+
+const COPY = {
+  es: {
+    address: 'Dale, te armo el presupuesto acá mismo. ¿Cuál es la dirección de la casa?',
+    addressRetry: 'No encontré esa dirección. ¿Me la escribís de nuevo, con calle, altura y localidad?',
+    addressChoice: (items) => `Encontré estas opciones, ¿cuál es la tuya?\n${items.map((it, i) => `${i + 1}) ${it.label}`).join('\n')}`,
+    addressChoiceRetry: 'Decime 1, 2 o 3 para elegir la dirección.',
+    ownership: '¿La casa es tuya, la alquilás, o la estás por construir?',
+    consumption: '¿Cuánto consumís por mes? Contame en kWh o cuánto pagás de luz; si no lo sabés, decime "no sé" y sigo con un valor de referencia.',
+    consumptionRetry: 'No te entendí el consumo. Decime un número en kWh, cuánto pagás de luz, o "no sé".',
+    goal: '¿Qué buscás: ahorrar en la factura, tener respaldo ante cortes, o ambos?',
+    name: '¿Cómo te llamás?',
+    nameRetry: 'Decime tu nombre para el informe.',
+    contact: 'Pasame tu mail o tu WhatsApp (con código de área) y te mando el informe.',
+    contactRetry: 'Ese mail o WhatsApp no me cierra. ¿Me lo pasás de nuevo?',
+    done: (s) => s,
+  },
+  en: {
+    address: 'Sure, let\'s put together your quote right here. What\'s the address of the house?',
+    addressRetry: 'I could not find that address. Can you write it again with street, number and town?',
+    addressChoice: (items) => `I found these, which one is yours?\n${items.map((it, i) => `${i + 1}) ${it.label}`).join('\n')}`,
+    addressChoiceRetry: 'Say 1, 2 or 3 to pick the address.',
+    ownership: 'Do you own the house, rent it, or is it being built?',
+    consumption: 'What is your monthly consumption? In kWh or your electricity bill amount; say "I don\'t know" and I\'ll use a reference value.',
+    consumptionRetry: 'I did not get that. Give me a number in kWh, your bill amount, or say you are not sure.',
+    goal: 'What are you after: lowering your bill, backup during outages, or both?',
+    name: 'What is your name?',
+    nameRetry: 'Tell me your name for the report.',
+    contact: 'Give me your email or WhatsApp (with area code) and I will send you the report.',
+    contactRetry: 'That email or WhatsApp does not look right. Can you send it again?',
+    done: (s) => s,
+  },
+};
+
+function copyFor(language) { return COPY[language] || COPY.en; }
+
+/* Salta un paso cuando el hilo ya sabe el dato (nombre real, WhatsApp
+ * verificado): nunca le repetimos a alguien un dato que ya nos dio. */
+function skippable(step, { thread, data }) {
+  if (step === 'name') return Boolean(String(thread.name || '').trim()) ? String(thread.name || '').trim() : null;
+  if (step === 'contact' && thread.verified && thread.whatsapp) return { method: 'whatsapp', value: thread.whatsapp };
+  return null;
+}
+
+function nextOpenStep(from, ctx) {
+  let i = STEPS.indexOf(from);
+  while (STEPS[i] !== 'done') {
+    i += 1;
+    const step = STEPS[i];
+    if (step === 'address_choice') continue; // sólo se entra explícitamente, nunca de paso
+    const known = skippable(step, ctx);
+    if (known !== null) { ctx.data[step] = known; continue; }
+    return step;
+  }
+  return 'done';
+}
+
+function ownerFor(cfg) {
+  if (cfg && cfg.installerId) return cfg;
+  const { whitelabel } = require('../../lib/data-pack');
+  const { acquisitionSite } = require('../../lib/homeowner-routing');
+  return acquisitionSite(whitelabel);
+}
+
+function absoluteUrl(host, pathname) {
+  const h = String(host || 'usabruno.com').split(',')[0].trim();
+  return `https://${h}${pathname}`;
+}
+
+const backupFor = (goal) => (goal === 'save' ? 'none' : goal === 'backup' ? 'full' : 'essential');
+const money = (n) => Math.round(Number(n) || 0).toLocaleString('es-AR');
+
+function summaryText(analysis, language) {
+  const plan = analysis.plans.find((p) => p.recommended) || analysis.plans[0];
+  const kwp = (Number(analysis.kwp) || 0).toFixed(1);
+  const savingsArs = analysis.gridPriceArsPerKwh && analysis.annualKwh
+    ? Math.round(analysis.annualKwh * analysis.gridPriceArsPerKwh) : null;
+  if (language === 'en') {
+    const savings = savingsArs ? ` It should save you around AR$ ${money(savingsArs)} a year in electricity.` : '';
+    return `With ${analysis.panels} panels (${kwp} kWp) the ${plan.name} plan runs USD ${money(plan.total)}.${savings} Here is your full report:`;
+  }
+  const savings = savingsArs ? ` Ahorrarías cerca de AR$ ${money(savingsArs)} por año en luz.` : '';
+  return `Con ${analysis.panels} paneles (${kwp} kWp) el plan ${plan.name} te sale USD ${money(plan.total)}.${savings} Este es tu informe:`;
+}
+
+/* Arma el lead, corre el mismo análisis que /api/quote/analysis y devuelve el
+ * mensaje final con el link al informe. Nunca lanza: un fallo de geocoder o
+ * de visión deja el lead con roofStudy null (preliminaryQuote arma con el
+ * caso de muestra), nunca sin informe. */
+async function complete({ thread, data, cfg, host, fetchImpl, language }) {
+  const owner = ownerFor(cfg);
+  const installerId = owner && owner.installerId;
+  if (!installerId) return null;
+  const created = await customerLeads.create({
