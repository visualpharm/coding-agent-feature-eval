+++ b/lib/quote-report-analysis.js
@@ -0,0 +1,109 @@
+'use strict';
+/* La proyección de informe completa: la cotización (lib/customer-quote), el
+ * término de sombra (lib/roof-shade: relevamiento propio si el pin cae sobre
+ * un techo relevado, Google Solar si midió el paño, nada si no hay dato), el
+ * visor de sol con ese término (lib/sun-model), el marco del techo cuando hay
+ * foto propia con el paño medido, y el rango del control de paneles del
+ * informe.
+ *
+ * Extraído de server/server.js (2026-09-07) para que el estimador del chat
+ * (modules/nimba/estimate.js) cotice con la MISMA función que el wizard: la
+ * ruta HTTP y el hilo de chat nunca pueden divergir en cómo arman un informe.
+ * La misma función cotiza la primera vez, cada re-cotización desde el informe
+ * y ahora el flujo del chat. */
+const { preliminaryQuote } = require('./customer-quote');
+const roofShade = require('./roof-shade');
+const { sunViewerFor } = require('./sun-model');
+const { sunFramesIndex } = require('./sun-frames');
+const googleSunFrames = require('./google-sun-frames');
+const { studyNear } = require('./private-study');
+const { privateStudies } = require('./data-pack');
+
+const FALLBACK_REPORT_MAX_PANELS = 24;
+
+function privateRoofFrame(study) {
+  const photo = study?.roofPhoto;
+  if (!photo?.src || !photo.quad) return null;
+  return {
+    kind: 'photo', measurement: 'private-study', src: photo.src,
+    width: Number(photo.width), height: Number(photo.height),
+    view: Array.isArray(photo.view) ? photo.view.map(Number) : null, quad: photo.quad,
+    cols: Number(photo.cols) || 1, rows: Number(photo.rows) || 1, flush: photo.flush !== false,
+    roof: photo.roof && Array.isArray(photo.roof.quads) ? { quads: photo.roof.quads } : null,
+    label: 'Relevamiento propio con dron',
+  };
+}
+
+function reportAnalysis({ lead, intake, roofStudy }) {
+  const study = studyNear(privateStudies, lead.lat, lead.lng);
+  const photo = study && study.roofPhoto;
+  const frameCapacity = photo && photo.cols && photo.rows ? Number(photo.cols) * Number(photo.rows) : null;
+  /* A private drone survey with a fixed panel grid is a direct measurement
+   * of THIS roof; a Google Solar/AI-vision estimate is a generic guess over
+   * a satellite or model-traced polygon. When both exist for the same lead,
+   * the survey's own count is the roof capacity — it must set the ceiling
+   * preliminaryQuote actually prices against, never sit beside a lower
+   * estimate that silently wins through Math.min below. Overriding only
+   * roofCapacityPanels keeps every other building field (source label,
+   * sunlight, panel dots for the map fallback) exactly as fetched. */
+  const roofStudyForQuote = frameCapacity && roofStudy && roofStudy.building
+    ? { ...roofStudy, building: { ...roofStudy.building, roofCapacityPanels: frameCapacity } }
+    : roofStudy;
+  const building = roofStudyForQuote && roofStudyForQuote.building;
+  /* Size against the same annual exposure that the report will display. A
+   * private measured study wins; otherwise use Google's per-position yield.
+   * Run the Google estimate once more after resizing so the selected prefix of
+   * positions drives both the panel count and the output. This factor is fed
+   * into pricing exactly once; sunViewer receives the already shaded monthly
+   * series and therefore does not subtract it again. */
+  const rawMeasuredExposure = study?.system?.selectedArrayAnnualExposurePercent;
+  const measuredExposure = rawMeasuredExposure != null ? Number(rawMeasuredExposure) / 100 : NaN;
+  const measuredYield = Number(study?.system?.annualKwh) / Number(study?.system?.dcKwp);
+  const baseInput = { ...intake, country: lead.country || intake.country || 'AR', roofStudy: roofStudyForQuote,
+    ...(Number.isFinite(measuredExposure) && measuredExposure >= 0 ? { shadeExposure: measuredExposure } : {}),
+    ...(measuredYield > 0 && measuredExposure > 0 ? { unshadedAnnualKwhPerKwp: measuredYield / measuredExposure } : {}),
+  };
+  let analysis = preliminaryQuote(baseInput);
+  for (let pass = 0; pass < 2; pass += 1) {
+    let exposure = Number.isFinite(measuredExposure) && measuredExposure >= 0 ? measuredExposure : null;
+    if (exposure === null && building && Array.isArray(building.solarPanels)) {
+      const google = roofShade.googleExposure(building, analysis.panels, analysis.sunlight);
+      exposure = google && Number.isFinite(google.year) ? google.year : null;
+    }
+    if (exposure === null || !Number.isFinite(exposure) || Math.abs(exposure - Number(analysis.shadeExposure ?? 1)) < 0.0001) break;
+    analysis = preliminaryQuote({ ...baseInput, shadeExposure: exposure });
+  }
+  const shade = (study && roofShade.studyShade(study, analysis.kwp))
+    || roofShade.googleExposure(building, analysis.panels, analysis.sunlight)
+    || null;
+  analysis.sunViewer = sunViewerFor({ lat: lead.lat, kwp: analysis.kwp, sunlight: analysis.sunlight, shade, monthlyKwh: analysis.monthlyGenerationKwh });
+  /* El mapa de calor real del techo (lib/sun-frames.js): sólo qué cuadros
+   * medidos existen; sin relevamiento, null y el visor no pinta mancha. */
+  analysis.sunFrames = (study && sunFramesIndex(study)) || googleSunFrames.indexFor(building);
+  /* Sin relevamiento propio bajo el pin, un marco que el lead ya tenía se
+   * conserva: la distribución elegida en la guía vive sobre ese marco. */
+  const measuredProvider = analysis.roofLayout?.frame?.provider
+    || ({ 'google-solar': 'google', 'google-vision': 'google', 'apple-vision': 'apple', 'drone-vision': 'own' })[analysis.roofLayout?.source];
+  const previousFrame = (!measuredProvider || measuredProvider === 'own') && lead.analysis?.roofFrame?.kind === 'photo'
+    ? lead.analysis.roofFrame : null;
+  analysis.roofFrame = privateRoofFrame(study) || previousFrame;
+  const measuredMax = analysis.roofFrame
+    ? analysis.roofFrame.cols * analysis.roofFrame.rows
+    : (Number(analysis.roofLayout && analysis.roofLayout.maxPanels) || Number(building && building.roofCapacityPanels) || 0);
+  /* El tope del control es lo que la cotización va a honrar: la cantidad
+   * medida (paño relevado o posiciones) recortada por la superficie útil del
+   * techo, que es el mismo tope que aplica preliminaryQuote (sized.byArea).
+   * Un control que ofrece 12 y un precio que se queda en 8 es un control
+   * roto — y ese tope nunca depende de la cantidad elegida: roofStudyForQuote
+   * (medición fija de este lead) es el único insumo, jamás panelCount. */
+  const capacity = preliminaryQuote({ ...intake, panelCount: 999, roofStudy: roofStudyForQuote }).panels;
+  const max = Math.max(analysis.panels, Math.min(measuredMax || FALLBACK_REPORT_MAX_PANELS, capacity));
+  /* La cantidad recomendada es la que la cotización elige sola (consumo o
+   * caso de muestra, siempre dentro del techo), sin la cantidad pedida. */
+  const recommended = Math.min(max, preliminaryQuote({ ...baseInput, shadeExposure: analysis.shadeExposure, panelCount: null }).panels);
+  analysis.panelRange = { min: 1, max, recommended };
+  analysis.propertyContext = lead.propertyContext || roofStudy?.propertyContext || null;
+  return analysis;
+}
+
+module.exports = { reportAnalysis, privateRoofFrame, FALLBACK_REPORT_MAX_PANELS };
