+test('parsers: consumo, factura, dueño, objetivo y contacto', () => {
+  assert.deepEqual(flow.parseConsumption('300 kwh'), { monthlyKwh: 300, consumptionSource: 'kwh-stated' });
+  assert.deepEqual(flow.parseConsumption('unos 1.200 kWh mas menos'), { monthlyKwh: 1200, consumptionSource: 'kwh-stated' });
+  assert.deepEqual(flow.parseConsumption('$45.000'), { monthlyBillArs: 45000, consumptionSource: 'monthly-bill' });
+  assert.deepEqual(flow.parseConsumption('45 mil'), { monthlyBillArs: 45000, consumptionSource: 'monthly-bill' });
+  assert.deepEqual(flow.parseConsumption('pago 60000 pesos'), { monthlyBillArs: 60000, consumptionSource: 'monthly-bill' });
+  assert.deepEqual(flow.parseConsumption('250'), { monthlyKwh: 250, consumptionSource: 'kwh-stated' });
+  assert.deepEqual(flow.parseConsumption('no idea'), { monthlyKwh: null, consumptionSource: 'unknown' });
+  assert.equal(flow.parseOwnership('la casa es mía'), 'owner');
+  assert.equal(flow.parseOwnership('soy inquilino'), 'renter');
+  assert.equal(flow.parseOwnership('estamos por construir'), 'planning');
+  assert.equal(flow.parseGoal('ahorrar'), 'save');
+  assert.equal(flow.parseGoal('que no me corte la luz'), 'backup');
+  assert.equal(flow.parseGoal('ambos'), 'lock');
+  assert.deepEqual(flow.parseContact('es nora@ejemplo.invalid'), { email: 'nora@ejemplo.invalid' });
+  assert.deepEqual(flow.parseContact('mi cel +54 9 11 0000-0000'), { whatsapp: '5491100000123' });
+});
+
+test.after(() => cleanupTestEnv());
