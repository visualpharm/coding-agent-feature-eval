diff --git a/test/chat-estimate.test.js b/test/chat-estimate.test.js
new file mode 100644
index 0000000..a3b3eab
--- /dev/null
+++ b/test/chat-estimate.test.js
@@ -0,0 +1,213 @@
+'use strict';
+/* El estimador del chat (modules/nimba/estimate-flow.js): las preguntas de
+ * precio/instalación entran al flujo — nunca a la visita ni a la lista de
+ * planes — y el flujo termina con el informe (/quote/results/<id>?t=) en el
+ * hilo, creado por el mismo camino que el wizard. Geocoder, estudio de techo
+ * y modelo vienen stubbeados: nada de acá sale a la red. */
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { bootstrapTestEnv, cleanupTestEnv } = require('../test-helpers/env');
+
+bootstrapTestEnv('bruno-chat-estimate', { sessionSecret: 'chat-estimate-test-secret-32-characters' });
+delete process.env.OPENROUTER_API_KEY;
+process.env.BRUNO_OPENROUTER_API_KEY = 'test-key-not-real';
+process.env.BRUNO_CHAT_MODEL = 'test/model';
+delete process.env.BRUNO_GOOGLE_PLACES_API_KEY;
+delete process.env.BRUNO_GOOGLE_MAPS_API_KEY;
+
+const store = require('../modules/nimba/store');
+const responder = require('../modules/nimba/responder');
+const flow = require('../modules/nimba/estimate-flow');
+const customerLeads = require('../lib/customer-leads');
+require('../server/server'); // reportAnalysis, el mismo informe que el wizard
+
+const HOST = 'esun.usabruno.com';
+const PINAMAR = { label: 'Retiro 1234, Pinamar, Buenos Aires, Argentina', lat: -37.11, lng: -56.87 };
+
+function deps(results) {
+  return {
+    geocodeSearch: async () => results,
+    studyFor: async () => null,
+  };
+}
+function fakeFetch(replies) {
+  const queue = [...replies];
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push(JSON.parse(init.body));
+    const text = queue.length > 1 ? queue.shift() : queue[0];
+    return { ok: true, status: 200, json: async () => ({ model: 'test/model', choices: [{ message: { content: text } }] }) };
+  };
+  fn.calls = calls;
+  return fn;
+}
+
+async function open(name, text) {
+  return store.recordWebInbound({ whatsapp: '', name, text, installerId: 'demo-installer', simulated: true, auto: true });
+}
+async function turn(thread, text, { fetchImpl, geocode = [PINAMAR] } = {}) {
+  const t = await store.appendWebInbound(thread.webToken, { text });
+  const r = await responder.answer({ thread: t, text, visitor: { name: thread.name, whatsapp: t.whatsapp }, fetchImpl, host: HOST, deps: deps(geocode) });
+  await store.recordOutbound(t.id, { text: r.text, by: 'Bruno (auto)', channel: 'web', auto: true, links: r.links || [] });
+  return r;
+}
+
+/* Ivan (2026-09-07): todas estas entradas del demo pack entran al flujo del
+ * estimador, ni visita ni precios de referencia. */
+test('los abridores de precio/instalación entran al estimador y reciben la pregunta de dirección', async () => {
+  const openers = [
+    'quiero instalar solar, cuánto sale?',
+    'cuánto cuesta',
+    'precio para mi casa',
+    'quiero paneles',
+    'how much',
+    'i want to install solar, how much?',
+    'me pasás un presupuesto?',
+  ];
+  for (const [i, opener] of openers.entries()) {
+    const t = await open(`Demo ${i}`, opener);
+    const r = await responder.answer({ thread: t, text: opener, visitor: { name: t.name }, host: HOST, deps: deps([PINAMAR]) });
+    assert.equal(r.mode, 'flow', opener);
+    assert.match(r.text, /dirección de la casa|property address/i, opener);
+    assert.doesNotMatch(r.text, /visita|USD|plan /i, `ningún opener oferta visita ni precios: ${opener}`);
+    assert.equal(r.escalate, false);
+    const stored = store.getForInstaller('demo-installer', t.id);
+    assert.equal(stored.estimate.step, 'address', opener);
+  }
+});
+
+test('camino feliz completo hasta el informe en el hilo', async () => {
+  const fetchImpl = fakeFetch(['x']);
+  const t = await open('Marcela Ferreyra', 'quiero instalar solar, cuánto sale?');
+  let r = await responder.answer({ thread: t, text: t.messages[0].text, visitor: { name: 'Marcela Ferreyra' }, host: HOST, deps: deps([PINAMAR]) });
+  assert.match(r.text, /dirección/);
+  r = await turn(t, 'Retiro 1234, Pinamar', { fetchImpl });
+  assert.match(r.text, /tuya|es tuya|own|rent/, 'paso dueño/inquilino');
+  r = await turn(t, 'es mía', { fetchImpl });
+  assert.match(r.text, /consumís|consume/, 'paso consumo');
+  r = await turn(t, '450 kwh', { fetchImpl });
+  assert.match(r.text, /ahorrar|respaldo|saving|backup/, 'paso qué busca');
+  r = await turn(t, 'ahorrar en la factura', { fetchImpl });
+  assert.match(r.text, /mail o un WhatsApp|email or WhatsApp/, 'paso contacto (el nombre ya se sabe del hilo)');
+  r = await turn(t, 'marcela@ejemplo.invalid', { fetchImpl });
+  assert.equal(r.mode, 'flow');
+  assert.match(r.text, /paneles/);
+  assert.match(r.text, /USD [\d.]+/);
+  assert.ok(r.links?.length === 1 && /\/quote\/results\/[a-f0-9-]+\?t=/.test(r.links[0].href), 'link al informe con token');
+  assert.match(r.links[0].href, new RegExp(`^https://${HOST.replace('.', '\\.')}/`));
+  assert.equal(r.links[0].label, 'Ver mi informe');
+
+  const stored = store.getForInstaller('demo-installer', t.id);
+  assert.equal(stored.estimate.done, true);
+  const lead = customerLeads.getForInstaller('demo-installer', stored.estimate.leadId);
+  assert.equal(lead.source, 'site-chat');
+  assert.equal(lead.intake.monthlyKwh, 450);
+  assert.equal(lead.intake.ownership, 'owner');
+  assert.equal(lead.intake.intent, 'save');
+  assert.equal(lead.contact.email, 'marcela@ejemplo.invalid');
+  assert.ok(lead.analysis && lead.analysis.panels >= 1, 'el informe quedó en el lead, por el mismo camino del wizard');
+  assert.match(stored.estimate.resultPath, /\/quote\/results\//);
+});
+
+test('consumo "no sé": sigue con el caso de muestra publicado, sin inventar techo', async () => {
+  const fetchImpl = fakeFetch(['x']);
+  const t = await open('Bruno Demo', 'cuánto cuesta poner paneles?');
+  await responder.answer({ thread: t, text: t.messages[0].text, visitor: { name: t.name }, host: HOST, deps: deps([PINAMAR]) });
+  await turn(t, 'Retiro 1234, Pinamar', { fetchImpl });
+  await turn(t, 'soy el dueño', { fetchImpl });
+  const r = await turn(t, 'no sé', { fetchImpl });
+  assert.match(r.text, /ahorrar|respaldo/, 'el no sé no frena: sigue al paso siguiente');
+  await turn(t, 'ambos', { fetchImpl });
+  const r2 = await turn(t, '+54 9 11 0000-0000', { fetchImpl });
+  assert.match(r2.text, /paneles/);
+  const stored = store.getForInstaller('demo-installer', t.id);
+  const lead = customerLeads.getForInstaller('demo-installer', stored.estimate.leadId);
+  assert.equal(lead.intake.consumptionSource, 'unknown');
+  assert.equal(lead.intake.monthlyKwh, null);
+  assert.ok(lead.analysis.panels >= 1, 'el tamaño de muestra pública cotiza igual');
+});
+
+test('acepta la factura en pesos y la convierte por el precio de red del pricing', async () => {
+  const fetchImpl = fakeFetch(['x']);
+  const t = await open('Dario Demo', 'me pasás un presupuesto?');
+  await responder.answer({ thread: t, text: t.messages[0].text, visitor: { name: t.name }, host: HOST, deps: deps([PINAMAR]) });
+  await turn(t, 'Retiro 1234, Pinamar', { fetchImpl });
+  await turn(t, 'alquilada', { fetchImpl });
+  await turn(t, '$45.000', { fetchImpl });
+  await turn(t, 'respaldo ante cortes', { fetchImpl });
+  await turn(t, 'dario@ejemplo.invalid', { fetchImpl });
+  const stored = store.getForInstaller('demo-installer', t.id);
+  const lead = customerLeads.getForInstaller('demo-installer', stored.estimate.leadId);
+  assert.equal(lead.intake.monthlyBillArs, 45000);
+  assert.equal(lead.intake.consumptionSource, 'monthly-bill');
+  assert.ok(lead.intake.monthlyKwh > 0, 'el monto se convierte con GRID_PRICE_PER_KWH, como /api/quote/analysis');
+  assert.equal(lead.intake.ownership, 'renter');
+  assert.equal(lead.intake.intent, 'backup');
+});
+
+test('interrupción: el modelo contesta la otra pregunta y la pregunta pendiente se repite en el mismo mensaje', async () => {
+  const fetchImpl = fakeFetch(['Garantía de 10 años en paneles y 5 en el inversor.']);
+  const t = await open('Nora Demo', 'precio para mi casa');
+  await responder.answer({ thread: t, text: t.messages[0].text, visitor: { name: t.name }, host: HOST, deps: deps([PINAMAR]) });
+  await turn(t, 'Retiro 1234, Pinamar', { fetchImpl });
+  await turn(t, 'propia', { fetchImpl });
+  const r = await turn(t, 'qué garantía tienen los paneles?', { fetchImpl });
+  assert.match(r.text, /10 años/, 'el modelo contestó la pregunta de más');
+  assert.match(r.text, /consumís|consume/, 'y la pregunta pendiente se repite en el mismo mensaje');
+  assert.equal(fetchImpl.calls.length, 1);
+  /* el flujo sigue intacto: la respuesta de consumo avanza */
+  const r2 = await turn(t, '300 kwh', { fetchImpl });
+  assert.match(r2.text, /ahorrar|respaldo/, 'siguió al paso siguiente');
+});
+
+test('dirección ambigua: lista numerada de a lo sumo 3 y el número elige', async () => {
+  const many = [
+    PINAMAR,
+    { label: 'Retiro 1234, Cariló, Buenos Aires, Argentina', lat: -37.16, lng: -56.89 },
+    { label: 'Retiro 1234, Valeria del Mar, Argentina', lat: -37.13, lng: -56.9 },
+    { label: 'Retiro 1234, Ostende, Argentina', lat: -37.15, lng: -56.88 },
+  ];
+  const fetchImpl = fakeFetch(['x']);
+  const t = await open('Ali Demo', 'how much for solar?');
+  let r = await responder.answer({ thread: t, text: t.messages[0].text, visitor: { name: t.name }, host: HOST, deps: deps(many) });
+  assert.equal(r.mode, 'flow');
+  assert.match(r.text, /dirección de la casa|property address/);
+  r = await turn(t, 'Retiro 1234', { fetchImpl, geocode: many });
+  assert.match(r.text, /1\..*\n2\..*\n3\./, 'lista numerada, a lo sumo 3');
+  assert.doesNotMatch(r.text, /Ostende/, 'el cuarto resultado no va');
+  r = await turn(t, '2', { fetchImpl, geocode: many });
+  assert.match(r.text, /own|rent|tuya/, 'eligió la 2 y siguió a dueño/inquilino');
+  const stored = store.getForInstaller('demo-installer', t.id);
+  assert.equal(stored.estimate.data.address.label, many[1].label);
+});
