+test('el prompt del respondedor ya no vuelca precios de planes ni ofrece la visita antes del informe', async () => {
+  const sys = responder.systemPrompt({ language: 'es', visitorName: 'Marcela', f: responder.facts() });
+  assert.doesNotMatch(sys, /Referencia para una casa que consume/);
+  assert.doesNotMatch(sys, /INSTALLER (confirma|sigue|va a|puede)/, 'INSTALLER ya no es el actor de las respuestas');
+  assert.match(sys, /nunca nombres a INSTALLER/);
+  assert.match(sys, /NO se cita por chat/);
+  assert.match(sys, /no ofrezcas una visita antes/i);
+  const withReport = responder.systemPrompt({ language: 'es', visitorName: 'Marcela', f: responder.facts(), hasReport: true });
+  assert.match(withReport, /ya tiene su informe/i);
+});
