diff --git a/modules/nimba/estimate-flow.js b/modules/nimba/estimate-flow.js
new file mode 100644
index 0000000..778986b
--- /dev/null
+++ b/modules/nimba/estimate-flow.js
@@ -0,0 +1,364 @@
+'use strict';
+/* El estimador del chat (Ivan, 2026-09-07): ante una pregunta de precio o de
+ * "quiero paneles" el bot NO recita planes ni ofrece una visita — hace en
+ * conversación lo mismo que el wizard /quote/*, un dato por mensaje, y termina
+ * creando el lead y mostrando el informe (/quote/results/<id>?t=) en el hilo.
+ *
+ * Determinista, no "prompt y rezar": la detección de intención y el avance de
+ * los pasos son código puro; el modelo sólo redacta cuando el visitante
+ * interrumpe con otra pregunta (y la pregunta pendiente se repite igual, la
+ * agrega este módulo, no el modelo). El análisis es el MISMO camino que
+ * /api/quote/analysis: customerLeads → roofInsights.studyFor →
+ * server.reportAnalysis (lib/customer-quote sobre lib/pricing), nunca una
+ * fórmula propia del chat. Sin contraseña ni cuenta: el informe queda
+ * protegido por el token ?t= del lead, como el wizard.
+ *
+ * El estado vive en el hilo (thread.estimate = { step, data }) a través del
+ * store atómico, con normalizador para los hilos previos. */
+const EMAIL_RE = /[\w.+-]+@[\w-]+\.[\w.-]+/;
+
+/* ── Intención: arrancar (o retomar) el estimador ─────────────────────────── */
+const norm = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
+/* Cotización: sólo pedida ("me cotizás", "una cotización"), nunca "ya tengo
+ * la cotización"; un "go solar" suelto tampoco alcanza para arrancar. */
+const INTENT_RE = /\b(cuanto (cuesta|sale|me sale|salen|seria|vale)|precio|presupuesto|cotizame|me cotizas|cotizar|una cotizacion|quiero paneles|quiero instalar|instalar (paneles|solar|energia)|poner (paneles|solar)|paneles solares|solar para (mi )?casa|how much|price|quote|cost|estimate|budget|want (solar|panels)|i want to install|install(ing)? solar)\b/;
+function wantsEstimate(text) { return INTENT_RE.test(norm(text)); }
+
+/* ── Paso pendiente y preguntas, un dato por mensaje ──────────────────────── */
+const ORDER = ['address', 'ownership', 'consumption', 'goal', 'name', 'contact'];
+const QUESTION = {
+  es: {
+    address: '¡Dale! Te armo el informe acá mismo. ¿Cuál es la dirección de la casa?',
+    addressRetry: 'No encontré esa dirección. Pasame la calle y la altura, por ejemplo «Retiro 1234, Pinamar».',
+    addressWhich: (n) => `Encontré varias:\n${n}\n¿Cuál es la tuya?`,
+    ownership: '¿La casa es tuya, alquilada o estás por construir?',
+    consumption: '¿Cuánto consumís por mes? Decime los kWh de la factura o más o menos cuánto pagás, y si no lo sabés, no pasa nada.',
+    goal: '¿Qué buscás principalmente: ahorrar en la factura, respaldo ante los cortes, o ambos?',
+    name: '¿A qué nombre guardo el informe?',
+    contact: '¿Te dejo un mail o un WhatsApp por si se cierra el navegador?',
+    thanks: 'Gracias',
+  },
+  en: {
+    address: "Great, let's put the report together right here. What's the property address?",
+    addressRetry: 'I could not find that address. Give me the street and number, like «Retiro 1234, Pinamar».',
+    addressWhich: (n) => `I found a few:\n${n}\nWhich one is yours?`,
+    ownership: 'Do you own the house, rent it, or are you building?',
+    consumption: 'How much do you consume per month? The kWh on your bill or roughly what you pay — and "no idea" is fine too.',
+    goal: 'What matters most: saving on the bill, backup for outages, or both?',
+    name: 'What name should I save the report under?',
+    contact: 'Can I get an email or WhatsApp in case the browser closes?',
+    thanks: 'Thanks',
+  },
+};
+const copy = (language) => QUESTION[language] || QUESTION.en;
+const pendingQuestion = (est, language) => {
+  const c = copy(language);
+  if (est.step === 'address-choice') return c.addressWhich(est.data.candidates.map((x, i) => `${i + 1}. ${x.label}`).join('\n'));
+  return c[est.step] || c.address;
+};
+
+/* ── Parsers: cada paso lee su dato del mensaje ───────────────────────────── */
+/* Número en castellano: «1.200» son mil doscientos, «1,5» es uno y medio,
+ * «45 mil» cuarenta y cinco mil. */
+function numOf(token) {
+  const t = String(token);
+  const sep = t.match(/[.,](\d{3})$/);
+  if (sep && !/,\d/.test(t)) return Number(t.replace(/[.,]/g, ''));
+  return Number(t.replace(',', '.'));
+}
+function parseNumber(raw) {
+  const t = norm(raw).replace(/\s+/g, ' ');
+  const mil = t.match(/(\d+(?:[.,]\d+)?)\s*mil\b/);
+  if (mil) return Math.round(numOf(mil[1]) * 1000);
+  const m = t.match(/(\d+(?:[.,]\d+)?)\s*(?:k\b)?/);
+  if (!m) return null;
+  return Math.round(numOf(m[1]));
+}
+/* Consumo: kWh explícito, o monto de factura ($45.000, 45 mil, 45000). Un
+ * número pelado hasta 2.500 lo leemos como kWh; más que eso, como pesos. */
+function parseConsumption(text) {
+  const t = norm(text);
+  if (/\b(no se|ni idea|no tengo idea|no me acuerdo|nop|no idea|not sure|dunno|dont know|don't know)\b/.test(t)) return { monthlyKwh: null, consumptionSource: 'unknown' };
+  const kwh = t.match(/(\d+(?:[.,]\d+)?)\s*(?:kwh|kw\b)/);
+  if (kwh) { const n = numOf(kwh[1]); if (n > 0) return { monthlyKwh: Math.round(n), consumptionSource: 'kwh-stated' }; }
+  const n = parseNumber(t);
+  if (n == null || n <= 0) return null;
+  const money = /(\$|pesos|ars\b|factura|pago|bill\b)/.test(t) || n > 2500;
+  return money ? { monthlyBillArs: n, consumptionSource: 'monthly-bill' } : { monthlyKwh: n, consumptionSource: 'kwh-stated' };
+}
+function parseOwnership(text) {
+  const t = norm(text);
+  if (/\b(no se|ni idea|not sure|dont know|don't know)\b/.test(t)) return 'unsure';
+  if (/\b(alquil|inquilin|rent|lease)/.test(t)) return 'renter';
+  if (/\b(construy|por construir|proyecto|terreno|build|planific|planning to)/.test(t)) return 'planning';
+  if (/\b(mia\b|duen|propia\b|propietari|own\b|owner|es nuestra)/.test(t)) return 'owner';
+  return null;
+}
+function parseGoal(text) {
+  const t = norm(text);
+  if (/\b(no se|ni idea|not sure|ambos|los dos|las dos|both|todo)\b/.test(t)) return 'lock';
+  if (/\b(corte|cortes|respaldo|bateria|back ?up|backup|outage|power cut|blackout)/.test(t)) return 'backup';
+  if (/\b(ahorr|factura|pagar menos|gastar menos|save|saving|bill)/.test(t)) return 'save';
+  return null;
+}
+function parseContact(text) {
+  const email = String(text).match(/[\w.+-]+@[\w-]+\.[\w.-]+/);
+  if (email) return { email: email[0].toLowerCase() };
+  const toWaId = require('../../lib/whatsapp').toWaId;
+  const digits = toWaId(text);
+  if (digits.length >= 10) return { whatsapp: digits };
+  return null;
+}
+
+/* ── Geocoder y análisis: los mismos que usa el wizard ────────────────────── */
+function defaultDeps() {
+  return {
+    geocodeSearch: (q, cfg) => require('../../lib/geocode').searchAddress(q, { cfg }),
+    studyFor: (lat, lng, owner) => require('../../lib/roof-insights').studyFor(lat, lng, { owner }),
+  };
+}
+
+function ownerFor(thread) {
+  try { return require('../../lib/brand-registry').byInstallerId(thread.installerId); } catch { return null; }
+}
+
+/* El turno del estimador. Devuelve { text, links?, mode } o null si el mensaje
+ * no es del flujo ni lo arranca. `language` es el idioma fijado del hilo. */
+async function turn({ thread, text, language, visitor = {}, fetchImpl, host, deps = defaultDeps() }) {
+  const est = thread.estimate && !thread.estimate.done ? thread.estimate : null;
+  if (!est && !wantsEstimate(text)) return null;
+  const c = copy(language);
+  const next = est || { step: 'address', data: {} };
+  const base = { mode: 'flow' };
+
+  /* Ya hay informe y vuelve a preguntar precio: el link otra vez, oferta de
+   * visita sólo acá (una, suave). */
+  if (!est && thread.estimate?.done) {
+    const url = `https://${host}${thread.estimate.resultPath}`;
+    return {
+      ...base,
+      text: language === 'en'
+        ? `Your report is ready from our last round. Here it is again — and if you want us to look at the roof in person, we can set that up.`
+        : `Tu informe ya quedó armado de la vuelta anterior; te lo dejo de nuevo. Y si querés que pasemos a ver el techo, lo coordinamos.`,
+      links: [{ label: language === 'en' ? 'See my report' : 'Ver mi informe', href: url }],
+    };
+  }
+
+  const store = require('./store');
+  const commit = (step, data) => store.setEstimate(thread.id, { step, data });
+  const data = { ...next.data };
+
+  /* Dirección: geocodificar como /api/quote/addresses (la librería, no HTTP). */
+  if (next.step === 'address' || next.step === 'address-choice') {
+    let pick = null;
+    if (next.step === 'address-choice') {
+      const n = Number(String(text).match(/\b[123]\b/)?.[0]);
+      pick = Number.isInteger(n) && n >= 1 && n <= (data.candidates || []).length ? data.candidates[n - 1] : null;
+      if (!pick) {
+        /* Volvió a escribir otra dirección en vez del número: la busca. */
+        const again = await resolveAddress(text, thread, deps);
+        if (again?.single) pick = again.single;
+        else if (again?.many) { await commit('address-choice', { ...data, candidates: again.many.slice(0, 3) }); return { ...base, text: c.addressWhich(again.many.slice(0, 3).map((x, i) => `${i + 1}. ${x.label}`).join('\n')) }; }
+        else if (again?.none) return { ...base, text: c.addressRetry };
+        else return { ...base, text: pendingQuestion(next, language) };
+      }
+    } else {
+      if (!looksLikeAddress(text)) { await commit('address', data); return { ...base, text: c.address }; }
+      const resolved = await resolveAddress(text, thread, deps);
+      if (resolved?.unavailable) { await commit('address', data); return { ...base, text: c.address }; }
+      if (resolved?.many) {
+        await commit('address-choice', { ...data, candidates: resolved.many.slice(0, 3) });
+        return { ...base, text: c.addressWhich(resolved.many.slice(0, 3).map((x, i) => `${i + 1}. ${x.label}`).join('\n')) };
+      }
+      if (resolved?.single) pick = resolved.single;
+      else return { ...base, text: c.addressRetry };
+    }
+    data.address = { label: pick.label, lat: pick.lat, lng: pick.lng };
+    data.candidates = [];
+    return advance({ thread, data, language, visitor, fetchImpl, host, deps, commit });
+  }
+
+  const steps = {
+    ownership: parseOwnership,
+    goal: parseGoal,
+  };
+  if (next.step === 'consumption') {
+    const parsed = parseConsumption(text);
+    if (parsed) Object.assign(data, parsed);
+    else return { ...base, text: await interruptedReply({ thread, text, language, visitor, fetchImpl, est: next }) };
+  } else if (next.step === 'name') {
+    const given = String(text).trim().split(/\s+/).slice(0, 2).join(' ').slice(0, 160);
+    if (/@|\d/.test(given)) {
+      /* Un mail o un teléfono donde va el nombre: se guarda como contacto y
+       * se vuelve a pedir el nombre; no es nombre. */
+      const contact = parseContact(text);
+      if (contact) Object.assign(data, contact);
+      else return { ...base, text: await interruptedReply({ thread, text, language, visitor, fetchImpl, est: next }) };
+    } else if (given.length >= 2 && /[a-zA-ZáéíóúñÁÉÍÓÚÑ]/.test(given)) data.name = given;
+    else return { ...base, text: await interruptedReply({ thread, text, language, visitor, fetchImpl, est: next }) };
+  } else if (next.step === 'contact') {
+    const parsed = parseContact(text);
+    if (parsed) Object.assign(data, parsed);
+    else return { ...base, text: await interruptedReply({ thread, text, language, visitor, fetchImpl, est: next }) };
+  } else if (steps[next.step]) {
+    const parsed = steps[next.step](text);
+    if (parsed) data[next.step] = parsed;
+    else return { ...base, text: await interruptedReply({ thread, text, language, visitor, fetchImpl, est: next }) };
+  }
+  return advance({ thread, data, language, visitor, fetchImpl, host, deps, commit });
+}
+
+/* Un mensaje con señal de dirección: una altura (número) o una localidad de
+ * la zona. «how much» no es una dirección; no gastamos el geocoder. */
+const { SERVICE_AREA } = require('./guardrails');
+function looksLikeAddress(text) {
+  const t = norm(text);
+  return /\d/.test(t) || SERVICE_AREA.some((z) => new RegExp(`(^|[^a-z])${z}([^a-z]|$)`).test(t));
+}
+
+/* Resuelve una dirección con el geocoder del wizard. `single` cuando hay una
+ * sola (o una claramente elegida), `many` cuando hay que elegir, `none` cuando
+ * el geocoder contestó sin resultados y `unavailable` cuando no hay geocoder
+ * (sin clave): en ese caso se pide la dirección sin más. */
+async function resolveAddress(text, thread, deps) {
+  const q = String(text).trim().slice(0, 300);
+  if (q.length < 5) return null;
+  try {
+    const owner = ownerFor(thread);
+    const results = await deps.geocodeSearch(q, owner);
+    if (!results.length) return { none: true };
+    if (results.length === 1) return { single: results[0] };
+    return { many: results.slice(0, 3) };
+  } catch (err) {
+    console.warn(`[chat-estimate] geocode failed: ${err.name}`);
+    return { unavailable: true };
+  }
+}
+
+/* Guarda lo que hay y avanza al primer paso sin dato, preguntándolo. */
+async function advance(ctx) {
+  const { thread, data, language, visitor, deps, commit } = ctx;
+  if (!data.name) data.name = firstName(visitor.name || thread.name);
+  if (!data.whatsapp && thread.verified && thread.whatsapp) data.whatsapp = thread.whatsapp;
+  for (const step of ORDER) {
+    if (step === 'address') continue; // ya resuelta antes de entrar acá
+    if (step === 'ownership' && !data.ownership) { await commit('ownership', data); return { mode: 'flow', text: copy(language).ownership }; }
+    if (step === 'consumption' && data.consumptionSource === undefined) { await commit('consumption', data); return { mode: 'flow', text: copy(language).consumption }; }
+    if (step === 'goal' && !data.goal) { await commit('goal', data); return { mode: 'flow', text: copy(language).goal }; }
+    if (step === 'name' && !data.name) { await commit('name', data); return { mode: 'flow', text: copy(language).name }; }
+    if (step === 'contact' && !data.email && !data.whatsapp) { await commit('contact', data); return { mode: 'flow', text: copy(language).contact }; }
+  }
+  return complete(ctx);
+}
+
+function firstName(name) {
+  const clean = String(name || '').replace(/^Simulación — /, '').trim().split(/\s+/)[0] || '';
+  return clean ? clean[0].toUpperCase() + clean.slice(1) : '';
+}
+
+/* Interrupción: el visitante preguntó otra cosa. El modelo contesta corto y la
+ * pregunta pendiente se repite en el mismo mensaje (la agrega el flujo). */
+async function interruptedReply({ thread, text, language, visitor, fetchImpl, est }) {
+  const pending = pendingQuestion(est, language);
+  const llm = require('../../lib/llm-chat');
+  const responder = require('./responder');
+  const guardrails = require('./guardrails');
+  /* En los tests sin fetch inyectado nunca salimos a la red (misma regla que
+   * el respondedor): repetir la pregunta pendiente alcanza. */
+  if (process.env.NODE_ENV === 'test' && !fetchImpl) return pending;
+  if (!llm.configured()) return pending;
+  try {
+    const messages = [
+      { role: 'system', content: responder.systemPrompt({ language, visitorName: guardrails.firstName(visitor.name || thread.name), f: responder.facts(), estimatorActive: true }) },
+      ...responder.history(thread, visitor),
+      { role: 'user', content: guardrails.pseudonymize(text, visitor) },
+      { role: 'system', content: 'The visitor changed the subject while an estimate flow is pending. Answer their question in ONE short sentence, do not re-ask anything, do not offer a visit or prices. The pending question is appended right after your sentence by the system.' },
+    ];
+    const attempt = await llm.complete({ messages, fetchImpl: fetchImpl || globalThis.fetch, maxTokens: 150, temperature: 0.3 });
+    if (!attempt.ok) return pending;
+    const check = guardrails.checkOutbound(attempt.text, { language, visitor });
+    if (!check.ok) return pending;
+    return `${check.text} ${pending}`;
+  } catch { return pending; }
+}
+
+/* ── Cierre: lead + informe por el mismo camino que /api/quote/analysis ───── */
+async function complete({ thread, data, language, host, deps }) {
+  const store = require('./store');
+  const customerLeads = require('../../lib/customer-leads');
+  const PRICING = require('../../lib/pricing');
+  const aerial = require('../../lib/aerial');
+  await store.setEstimate(thread.id, { step: 'analyzing', data });
+  try {
+    const owner = ownerFor(thread);
+    const propertyContext = await require('../../lib/property-context').resolve(data.address.lat, data.address.lng).catch(() => null);
+    const country = propertyContext?.country || await require('../../lib/geocode').countryForPoint(data.address.lat, data.address.lng).catch(() => null);
+    const created = await customerLeads.create({
+      installerId: thread.installerId, source: 'site-chat',
+      address: data.address.label, lat: data.address.lat, lng: data.address.lng,
+      imagery: aerial.imageryFor(owner, data.address.lat, data.address.lng),
+      country, propertyContext, simulated: thread.simulated === true,
+    });
+    await customerLeads.setContact(created.id, created.access, {
+      name: data.name, email: data.email || '', whatsapp: data.whatsapp || '',
+      followupConsent: true, marketingConsent: false,
+    });
+    /* El mismo intake que arma /api/quote/analysis con lo que el chat pidió. */
+    let monthlyKwh = data.monthlyKwh ?? null;
+    let monthlyBillArs = null;
+    let consumptionSource = data.consumptionSource || 'unknown';
+    if (data.monthlyBillArs) {
+      monthlyBillArs = data.monthlyBillArs;
+      monthlyKwh = Math.round(monthlyBillArs / PRICING.GRID_PRICE_PER_KWH);
+      consumptionSource = 'monthly-bill';
+    }
+    const intent = ['save', 'backup', 'lock'].includes(data.goal) ? data.goal : 'other';
+    const intake = {
+      country: String(country || 'AR'),
+      monthlyKwh, monthlyBillArs, monthlyBillLocal: monthlyBillArs, billCurrency: 'ARS', sourceBillCurrency: 'ARS',
+      gridPriceArsPerKwh: PRICING.GRID_PRICE_PER_KWH, gridPricePerKwh: PRICING.GRID_PRICE_PER_KWH,
+      consumptionSource: ['monthly-bill', 'invoice', 'unknown'].includes(consumptionSource) ? consumptionSource : 'unknown',
+      intent, intentOther: '',
+      ownership: ['owner', 'renter', 'planning', 'unsure'].includes(data.ownership) ? data.ownership : 'other',
+      ownershipOther: '',
+      phase: 'unknown', roofType: 'unknown', shade: 'unknown',
+      backup: intent === 'save' ? 'none' : intent === 'backup' ? 'full' : 'essential',
+      newBuild: data.ownership === 'planning',
+    };
+    let roofStudy = null;
+    try { roofStudy = await deps.studyFor(data.address.lat, data.address.lng, owner); }
+    catch (err) { console.warn(`[chat-estimate] roof study failed: ${err.name}`); }
+    /* La misma composición del informe del wizard, sin fórmula propia. */
+    const analysis = require('../../server/server').reportAnalysis({ lead: customerLeads.get(created.id, created.access), intake, roofStudy });
+    const updated = await customerLeads.setAnalysis(created.id, created.access, { intake, analysis, roofStudy });
+    const resultPath = `/quote/results/${encodeURIComponent(created.id)}?t=${encodeURIComponent(created.access)}`;
+    await store.setEstimate(thread.id, { step: 'done', data, done: true, leadId: created.id, resultPath });
+    return summary({ analysis: updated.analysis || analysis, resultPath, language, host });
+  } catch (err) {
+    console.warn(`[chat-estimate] analysis failed: ${err.name}: ${err.message}`);
+    await store.setEstimate(thread.id, { step: 'contact', data });
+    const c = copy(language);
+    return language === 'en'
+      ? `Something broke on our side while building the report. The wizard at /quote/start gets you the same report in two minutes — or write us again and we'll retry.`
+      : `Se nos rompió algo de nuestro lado armando el informe. El wizard en /quote/start te da el mismo informe en dos minutos, o escribime de nuevo y lo reintentamos.`;
+  }
+}
+
+function summary({ analysis, resultPath, language, host }) {
+  const plans = (analysis.plans || []).slice().sort((a, b) => a.totalUsd - b.totalUsd);
+  const best = plans[0];
+  const usd = Math.round(best.totalUsd).toLocaleString(language === 'en' ? 'en-US' : 'es-AR');
+  const kwp = (Math.round(analysis.kwp * 10) / 10).toLocaleString(language === 'en' ? 'en-US' : 'es-AR');
+  const label = language === 'en' ? 'See my report' : 'Ver mi informe';
+  const savingsLine = analysis.gridPriceArsPerKwh && analysis.consumptionSource !== 'unknown'
+    ? (language === 'en'
+      ? ` It should cover about ${Math.round(analysis.annualKwh).toLocaleString('en-US')} kWh a year — roughly ARS ${Math.round(analysis.annualKwh * analysis.gridPriceArsPerKwh).toLocaleString('es-AR')} of what you pay today.`
+      : ` Cubre unos ${Math.round(analysis.annualKwh).toLocaleString('es-AR')} kWh al año: más o menos $${Math.round(analysis.annualKwh * analysis.gridPriceArsPerKwh).toLocaleString('es-AR')} de la factura de hoy.`)
+    : '';
+  const text = language === 'en'
+    ? `Done: for your roof we'd put ${analysis.panels} panels (${kwp} kWp); the starting plan is USD ${usd} installed.${savingsLine} Open your report for the layout on the roof and all three plans.`
+    : `Listo: para tu techo van ${analysis.panels} paneles (${kwp} kWp); el plan de arranque sale USD ${usd} instalado.${savingsLine} Abrí tu informe para ver los paneles sobre el techo y los tres planes.`;
+  return { mode: 'flow', text, links: [{ label, href: `https://${host}${resultPath}` }] };
+}
+
+module.exports = { turn, wantsEstimate, pendingQuestion, parseConsumption, parseOwnership, parseGoal, parseContact };
