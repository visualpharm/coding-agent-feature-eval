+'use strict';
+/* El estimador del chat (Ivan, 2026-09-07): ante «cuánto sale / quiero
+ * paneles / how much» el bot NO enumera planes ni ofrece una visita como
+ * cualquier instalador — recorre el wizard (/quote) en forma de conversación,
+ * un dato por mensaje, y termina mostrando el informe (/quote/results/<id>?t=)
+ * en el hilo. Todo determinista y sin modelo: la puerta de entrada es un gate
+ * de texto (wantsEstimate), el paso es una máquina de estados persistida en el
+ * hilo (thread.estimate, store.js) y la cotización final corre el MISMO
+ * camino que /api/quote/analysis — customerLeads + roofInsights +
+ * lib/quote-analysis#reportAnalysis — sin ninguna fórmula propia del chat.
+ *
+ * Pasos: dirección (geocodificada con el mismo lib/geocode que
+ * /api/quote/addresses; varias coincidencias → lista numerada de a 3) →
+ * dueño/inquilino/por comprar → consumo (kWh o factura; «no sé» cae al caso
+ * de muestra publicado, nunca llena el techo porque sí) → objetivo → nombre →
+ * mail o WhatsApp. Cada paso se salta si el dato ya se conoce (nombre del
+ * hilo, WhatsApp de un hilo verificado, mail del lead, dirección en el
+ * mensaje). Una pregunta ajena al flujo la contesta el modelo y el paso
+ * pendiente se repite en el mismo mensaje (responder.js). */
+
+const geocode = require('../../lib/geocode');
+const guardrails = require('./guardrails');
+
+const STEPS = ['address', 'addressPick', 'ownership', 'consumption', 'intent', 'name', 'contact', 'done'];
+const MAX_PICKS = 3;
+const EMAIL_RE = /^\S+@\S+\.\S+$/; // same shape /api/quote/contact accepts
+
+/* ── Copy: voseo corto, un dato por mensaje ─────────────────────────────── */
+const COPY = {
+  es: {
+    entry: (first) => `¡Dale${first ? `, ${first}` : ''}! Te lo estimo acá mismo, con los paneles sobre tu techo. ¿En qué dirección está la casa?`,
+    addressAsk: '¿En qué dirección está la casa? Ej: Retiro 512, Cariló.',
+    addressMiss: 'No encontré esa dirección. Pasamela como «Calle 123, Pinamar» y sigo.',
+    addressPick: (labels) => `Encontré varias:\n${labels.map((l, i) => `${i + 1}. ${l}`).join('\n')}\n¿Cuál es?`,
+    addressPickMiss: 'Decime el número de la lista (1, 2 o 3) o pasame la dirección completa con calle y altura.',
+    ownership: '¿La casa es tuya, alquilada o estás por comprarla?',
+    consumption: '¿Cuánto consumís por mes? Con los kWh de la factura o más o menos lo que pagás (ej: 300 kWh o $45.000); si no lo sabés, decime «no sé».',
+    consumptionAgain: 'No lo pude leer. Decime los kWh (ej: 300) o lo que pagás por mes (ej: $45.000); «no sé» también sirve.',
+    intent: '¿Qué buscás principalmente: ahorrar en la factura o respaldo ante los cortes?',
+    name: '¿Cómo te llamás?',
+    contact: 'Último paso: ¿a qué mail o WhatsApp te mando el informe?',
+    contactAgain: 'No lo pude leer. Pasame un mail (nombre@dominio.invalid) o un WhatsApp con característica.',
+    working: 'Estoy armando tu informe con los paneles sobre tu techo…',
+    reportLabel: 'Ver mi informe',
+    failed: 'No pude armar el informe ahora. Una persona del equipo te escribe en un rato para terminarlo.',
+    summary: ({ first, address, panels, kwp, plan, price, savings }) =>
+      `¡Listo${first ? `, ${first}` : ''}! Para ${address} entran ${panels} paneles (${kwp} kWp). El plan ${plan} sale ${price}${savings ? ` y ahorrarías unos ${savings} por año` : ''}; el informe completo queda acá:`,
+  },
+  en: {
+    entry: (first) => `Great${first ? `, ${first}` : ''}! I can estimate it right here, with the panels on your roof. What is the property address?`,
+    addressAsk: 'What is the property address? E.g. Retiro 512, Cariló.',
+    addressMiss: 'I could not find that address. Send it as «Street 123, Pinamar» and I will keep going.',
+    addressPick: (labels) => `I found a few:\n${labels.map((l, i) => `${i + 1}. ${l}`).join('\n')}\nWhich one is it?`,
+    addressPickMiss: 'Reply with the list number (1, 2 or 3), or the full address with street and number.',
+    ownership: 'Do you own the house, rent it, or are you about to buy?',
+    consumption: 'How much do you consume per month? The kWh from your bill or roughly what you pay (e.g. 300 kWh or $45,000); «I don\'t know» is fine too.',
+    consumptionAgain: 'I could not read that. Tell me the kWh (e.g. 300) or your monthly bill (e.g. $45,000); «I don\'t know» works too.',
+    intent: 'What are you mainly after: saving on your bill, or backup during outages?',
+    name: 'What is your name?',
+    contact: 'Last step: which email or WhatsApp should I send the report to?',
+    contactAgain: 'I could not read that. Give me an email (name@domain.invalid) or a WhatsApp number with area code.',
+    working: 'I am putting your report together, with the panels on your roof…',
+    reportLabel: 'See my report',
+    failed: 'I could not finish the report right now. Someone from the team will write you here shortly to complete it.',
+    summary: ({ first, address, panels, kwp, plan, price, savings }) =>
+      `Done${first ? `, ${first}` : ''}! For ${address} there is room for ${panels} panels (${kwp} kWp). The ${plan} plan is ${price}${savings ? `, saving you about ${savings} a year` : ''}; the full report is right here:`,
+  },
+};
+const copy = (language) => COPY[language] || COPY.es;
+
+/* ── Gate: el visitante pide precio / presupuesto / instalar ─────────────── */
+const GATE_RE = /\b(cu[aá]nt[oa]?\s+(?:me\s+)?(?:cuesta|cuestan|sale|salen|vale|valen|es|son|saldr[ií]a|costar[ií]a)|me\s+pas[aá]s(?:\s+(?:un|el))?\s+(?:presupuesto|precio|cotizaci[oó]n)|presupuesto|cotizaci[oó]n|precio|quiero\s+(?:paneles|instalar(?:me)?\s+solar|solar|poner(?:me)?\s+paneles)|instalar\s+(?:paneles|solar)|paneles\s+(?:solares?\s+)?para|solar\s+para\s+(?:mi\s+)?(?:casa|departamento|negocio|quinta)|how\s+much|what'?s\s+the\s+(?:price|cost|ballpark)|price\s+of|get\s+a\s+quote|quote|estimate\s+(?:for|to\s+install)|budget|i\s+want\s+(?:to\s+install|solar|panels)|want\s+(?:solar|to\s+go\s+solar)|going\s+solar)\b/i;
+/* Precio de OTRA cosa (la visita, un arreglo, el mantenimiento) no arranca el
+ * estimador: eso lo atiende el modelo. */
+const GATE_SKIP_RE = /\b(visita|visitar|encarg[aée]|mantenimiento|reparaci[oó]n|reparar|arreglo|service|limpieza|retiro|desmontaje|visit|maintenance|repair|fix|cleaning|removal)\b/i;
+
+function wantsEstimate(text) {
+  const t = String(text || '');
+  return GATE_RE.test(t) && !GATE_SKIP_RE.test(t);
+}
+
+/* ── Parsers de cada paso (deterministas, es/en) ─────────────────────────── */
+/* Ojo con el \b final: «é» NO es word-char en JS, así que \b tras [eé] nunca
+ * matchea «no sé». El lookahead niega letras (con acentos) en su lugar. */
+const DONT_KNOW_RE = /\b(no\s?s[eé]|ni\s?idea|no\s+la\s+tengo|no\s+tengo|despu[eé]s\s+te\s+paso|dont\s?know|don'?t\s+know|not\s+sure)(?![a-záéíóúñü])/i;
+
+function parseOwnership(text) {
+  const t = String(text || '');
+  if (/\b(due[ñn]\w*|propietari\w*|propia|es\s+m[íi]a|own(?:er|ed)?|mine)\b/i.test(t)) return 'owner';
+  if (/\b(alquil\w*|inquilin\w*|rent(?:al|ing)?\b|landlord)\b/i.test(t)) return 'renter';
+  if (/\b(todav[íi]a\s+no|por\s+comprar|voy\s+a\s+comprar|buscando\s+(?:casa|comprar)|terreno|lote\b|proyecto|a\s+futuro|planeo|planning\s+to\s+buy|not\s+yet|about\s+to\s+buy|buying)\b/i.test(t)) return 'planning';
+  if (DONT_KNOW_RE.test(t)) return 'unsure';
+  return null;
+}
+
+/* «45.000» (AR) y «45,000» (US) → 45000; «45,5» → 45.5; «45000» → 45000. */
+function esNumber(raw) {
+  let s = String(raw || '').trim();
+  if (/^\d{1,3}(,\d{3})+$/.test(s)) s = s.replace(/,/g, '');
+  else s = s.replace(/\.(?=\d{3}(\D|$))/g, '').replace(',', '.');
+  const n = Number(s);
+  return Number.isFinite(n) ? n : NaN;
+}
+
+function parseConsumption(text) {
+  const t = String(text || '').replace(/\s+/g, ' ').trim();
+  if (DONT_KNOW_RE.test(t)) return { unknown: true };
+  const kwh = t.match(/(\d{1,6}(?:[.,]\d{1,2})?)\s*(?:kwh|kwhs|kw\b)/i);
+  if (kwh) {
+    const n = esNumber(kwh[1]);
+    if (n >= 20 && n <= 50000) return { monthlyKwh: Math.round(n) };
+  }
+  /* «45 mil» sólo como gasto: un consumo nunca se dice en miles. */
+  const mil = t.match(/(\d{1,3}(?:[.,]\d{1,2})?)\s*mil\b/i);
+  if (mil) {
+    const n = esNumber(mil[1]);
+    if (n > 0 && n <= 2000) return { monthlyBillLocal: Math.round(n * 1000) };
+  }
+  const money = t.match(/(?:\$|us\$|usd|ars|pesos?)\s*(\d{1,3}(?:[.,]\d{3})+|\d{1,9}(?:[.,]\d{1,2})?)/i);
+  if (money) {
+    const n = esNumber(money[1]);
+    if (n >= 500 && n <= 20000000) return { monthlyBillLocal: Math.round(n) };
+  }
+  const bare = t.match(/^(\d{1,3}(?:[.,]\d{3})+|\d{1,6})$/);
+  if (bare) {
+    const n = esNumber(bare[1]);
+    if (n >= 500) return { monthlyBillLocal: Math.round(n) };
+    if (n >= 20) return { monthlyKwh: Math.round(n) };
+  }
+  return null;
+}
+
+function parseIntent(text) {
+  const t = String(text || '');
+  const both = /\b(ambos|ambas|las\s+dos|los\s+dos|todo\b|both|everything|two\s+things)\b/i.test(t);
+  if (both) return { intent: 'other', intentOther: 'Ahorrar en la factura y respaldo ante cortes' };
+  if (/\b(ahorr\w*|pagar\s+menos|bajar(?:me)?\s+(?:la\s+)?(?:factura|gasto|lujo)|m[aá]s\s+barato|save|pay(?:ing)?\s+less|cheaper|lower\s+(?:my\s+)?bill)\b/i.test(t)) return { intent: 'save' };
+  if (/\b(corte?s?\b|respaldo|bater[ií]as?\b|sin\s+luz|autonom[ií]a|backup|outages?|blackouts?|power\s+(?:during|cut)|when\s+the\s+power)\b/i.test(t)) return { intent: 'backup' };
+  if (DONT_KNOW_RE.test(t)) return { intent: 'unsure', intentOther: '' };
+  return null;
+}
+
+function parseName(text) {
+  let t = String(text || '').replace(/\s+/g, ' ').trim()
+    .replace(/^(me\s+llamo|soy|mi\s+nombre\s+es|my\s+name\s+is|i\s+am|i'?m)\s+/i, '');
+  if (!/^[a-záéíóúñü' -]{2,60}$/i.test(t)) return null;
+  if (DONT_KNOW_RE.test(t) || /^(no|si|sí|dale|ok|gracias|nada)$/i.test(t)) return null;
+  const words = t.split(' ');
+  if (words.length > 4) return null;
+  if (!/[aeiouáéíóú]/i.test(t)) return null;
+  /* Los nombres de personas nunca en mayúsculas (regla de UI). */
+  return t.toLowerCase().replace(/(^|[' -])(\p{L})/gu, (m, sep, letter) => sep + letter.toUpperCase());
+}
+
+function parseContact(text) {
+  const t = String(text || '').trim();
+  const email = t.match(/[\w.+-]+@[\w-]+\.[\w.-]+/);
+  if (email) return { email: email[0].toLowerCase().slice(0, 254) };
+  const digits = t.replace(/[^\d+]/g, '');
+  if (digits.replace(/\D/g, '').length >= 8) {
+    const wa = String(require('../../lib/whatsapp').toWaId(digits) || '');
+    if (wa.length >= 10) return { whatsapp: `+${wa}` };
+  }
+  return null;
+}
+
+/* Una dirección tipeada en el propio mensaje («… en Retiro 512, Cariló»). */
+function extractAddressQuery(text) {
+  const t = String(text || '');
+  const street = t.match(/\b(?:calle|av\.?|avenida|bv\.?|boulevard|pasaje|pje\.?|camino|callej[oó]n|ruta|via|street|avenue|road)\s+([a-záéíóúñü0-9'.\- ]{2,40}?)\s+(\d{1,5})\b/i);
+  if (street) return `${street[1].trim()} ${street[2]}`;
+  const near = t.match(/\b(?:es|está|esta|casa|vivienda|house|it'?s)\s+(?:en|in|at)\s+([a-záéíóúñü0-9'.\- ]{4,50}?\s+\d{1,5}[a-z]?)\b/i);
+  if (near) return near[1].replace(/\s+/g, ' ').trim();
+  return null;
+}
+
+/* ── Estado ──────────────────────────────────────────────────────────────── */
+function stepFor(data) {
+  if (!data.address) return 'address';
+  if (data.ownership == null) return 'ownership';
+  if (!(data.monthlyKwh || data.monthlyBillLocal || data.consumptionUnknown)) return 'consumption';
+  if (!data.intent) return 'intent';
+  if (!data.name) return 'name';
+  if (!(data.email || data.whatsapp)) return 'contact';
+  return 'done';
+}
+
+function seedData(thread, visitor = {}) {
+  const data = {
+    address: null, candidates: [], country: null,
+    ownership: null, monthlyKwh: null, monthlyBillLocal: null, consumptionUnknown: false,
+    intent: null, intentOther: '', name: null, email: null, whatsapp: null,
+  };
+  /* Nombre del hilo y mail del lead ya capturado: no se vuelven a pedir. El
+   * WhatsApp sólo si el hilo está verificado (el número probó ser suyo). */
+  const name = guardrails.firstName(String(thread.name || '').replace(/^Simulación — /, ''));
+  if (name) data.name = name;
+  if (visitor.email && EMAIL_RE.test(String(visitor.email))) data.email = String(visitor.email).toLowerCase();
+  if (thread.verified === true && thread.whatsapp) data.whatsapp = String(thread.whatsapp).slice(0, 60);
+  return data;
+}
+
+function questionFor(flow, language) {
+  const c = copy(language);
+  switch (flow.step) {
+    case 'addressPick': return c.addressPick(flow.data.candidates.map((x) => x.label));
+    case 'address': return c.addressAsk;
+    case 'ownership': return c.ownership;
+    case 'consumption': return c.consumption;
+    case 'intent': return c.intent;
+    case 'name': return c.name;
+    case 'contact': return c.contact;
+    default: return '';
+  }
+}
+
+async function resolveAddress(query, owner) {
+  let items = [];
+  try { items = await geocode.searchAddress(String(query || ''), { cfg: owner || null, locationHint: '' }); }
+  catch (_err) { items = []; }
+  if (!Array.isArray(items)) items = [];
+  const seen = new Set();
+  const out = [];
+  for (const item of items) {
+    const label = String(item && item.label || '').slice(0, 300);
+    const lat = Number(item && item.lat);
+    const lng = Number(item && item.lng);
+    const key = label.toLowerCase();
+    if (!label || !Number.isFinite(lat) || !Number.isFinite(lng) || seen.has(key)) continue;
+    seen.add(key);
+    out.push({ label, lat, lng });
+  }
+  return out;
+}
+
+/* ── La máquina: un mensaje del visitante sobre el flujo ─────────────────── */
+/* Devuelve { handled, text, links, estimate, action } cuando el flujo se
+ * queda el turno; { handled:false, pending } cuando el mensaje es otra cosa y
+ * el paso pendiente se repite después de la respuesta del modelo. */
+async function intercept({ thread, text, language, visitor = {}, owner = null, host = '' }) {
+  const lang = language || thread.language || 'es';
+  const flow = thread.estimate && typeof thread.estimate === 'object' && STEPS.includes(thread.estimate.step) ? thread.estimate : null;
+  if (flow && flow.report) return { handled: false, reportReady: true };
+
+  if (!flow) {
+    if (!wantsEstimate(text)) return { handled: false };
+    const data = seedData(thread, visitor);
+    const started = { step: 'address', data, host: String(host || '').slice(0, 200), startedAt: new Date().toISOString(), report: null };
+    const q = extractAddressQuery(text);
+    if (q) {
+      const turn = await addressTurn(started, q, lang, owner, { entry: true });
+      return turn;
+    }
+    const c = copy(lang);
+    const seededName = guardrails.firstName(String(data.name || ''));
+    const next = { ...started, step: stepFor(data) };
+    /* Nombre/contacto ya conocidos: el flujo arranca igual por la dirección. */
+    return { handled: true, text: c.entry(seededName), estimate: next };
+  }
+
+  switch (flow.step) {
+    case 'address':
+    case 'addressPick':
+      return addressTurn(flow, text, lang, owner, {});
+    case 'ownership': {
+      const ownership = parseOwnership(text);
+      if (!ownership) return reaskOrPending(flow, lang, text);
+      return stepDone(flow, { ownership }, lang);
+    }
+    case 'consumption': {
+      const parsed = parseConsumption(text);
+      if (!parsed) {
+        if (/\d/.test(text)) return { handled: true, text: copy(lang).consumptionAgain, estimate: flow };
+        return reaskOrPending(flow, lang, text);
+      }
+      const patch = parsed.unknown ? { consumptionUnknown: true } : parsed.monthlyKwh ? { monthlyKwh: parsed.monthlyKwh } : { monthlyBillLocal: parsed.monthlyBillLocal };
+      return stepDone(flow, patch, lang);
+    }
+    case 'intent': {
+      const parsed = parseIntent(text);
+      if (!parsed) return reaskOrPending(flow, lang, text);
+      return stepDone(flow, { intent: parsed.intent, intentOther: parsed.intentOther || '' }, lang);
+    }
+    case 'name': {
+      const name = parseName(text);
+      if (!name) return reaskOrPending(flow, lang, text);
+      return stepDone(flow, { name }, lang);
+    }
+    case 'contact': {
+      const contact = parseContact(text);
+      if (!contact) {
+        if (/[@\d]/.test(text)) return { handled: true, text: copy(lang).contactAgain, estimate: flow };
+        return reaskOrPending(flow, lang, text);
+      }
+      return stepDone(flow, contact, lang);
+    }
+    default:
+      return { handled: false };
+  }
+}
+
+/* El paso actual como pregunta, para repetirlo tras una respuesta del modelo. */
+function pendingQuestion(flow, language) {
+  const c = copy(language);
+  switch (flow.step) {
+    case 'address': return c.addressAsk;
+    case 'addressPick': return c.addressPickMiss;
+    case 'ownership': return c.ownership;
+    case 'consumption': return c.consumption;
+    case 'intent': return c.intent;
+    case 'name': return c.name;
+    case 'contact': return c.contact;
+    default: return '';
+  }
+}
+
+/* El mensaje no avanzó el flujo: si vuelve a pedir precio, se repite el paso;
+ * si es otra cosa, la contesta el modelo y el paso se repite en el mismo
+ * mensaje (responder.js). */
+function reaskOrPending(flow, language, text) {
+  if (wantsEstimate(text)) return { handled: true, text: pendingQuestion(flow, language), estimate: flow };
+  return { handled: false, pending: pendingQuestion(flow, language) };
+}
+
+function stepDone(flow, patch, language) {
+  const data = { ...flow.data, ...patch };
+  const step = stepFor(data);
+  const next = { ...flow, data, step };
+  if (step === 'done') {
+    /* El informe tarda unos segundos: primero el aviso, después el link. */
+    return { handled: true, text: copy(language).working, estimate: next, action: { type: 'complete', data } };
+  }
+  return { handled: true, text: questionFor(next, language), estimate: next };
+}
+
+/* La elección numerada de una lista pendiente: «2», «la segunda», «second». */
+function pickIndex(text) {
+  const t = String(text || '').trim();
+  const digit = t.match(/^(?:la\s+|el\s+)?([1-3])\b/i);
+  if (digit) return Number(digit[1]) - 1;
+  const words = { primera: 0, primer: 0, primero: 0, first: 0, segunda: 1, segundo: 1, second: 1, tercera: 2, tercer: 2, tercero: 2, third: 2 };
+  const word = t.toLowerCase().match(/\b(primera|primer|primero|first|segunda|segundo|second|tercera|tercer|tercero|third)\b/);
+  if (word) return words[word[1]] != null ? words[word[1]] : null;
+  return null;
+}
+
+/* Dirección: resolver, elegir entre varias, o volver a pedir. */
+async function addressTurn(flow, text, language, owner, { entry = false } = {}) {
+  const c = copy(language);
+  /* Elección numerada de una lista pendiente. */
+  if (flow.step === 'addressPick') {
+    const idx = pickIndex(text);
+    if (idx != null) {
+      const chosen = flow.data.candidates[idx];
+      if (chosen) return stepDone(flow, { address: chosen, candidates: [] }, language);
+    }
+    /* Otra dirección en vez del número: se resuelve como nueva consulta. */
+    const q = extractAddressQuery(text) || String(text || '').trim();
+    if (/[a-záéíóúñ]/i.test(q) && /\d/.test(q) && q.length >= 5) {
+      const items = await resolveAddress(q, owner);
+      if (items.length) return acceptAddress(flow, items, language);
+    }
+    return { handled: true, text: c.addressPickMiss, estimate: flow };
+  }
+  const q = extractAddressQuery(text) || String(text || '').trim();
+  const missText = entry ? c.entry(guardrails.firstName(String(flow.data.name || ''))) : c.addressMiss;
+  if (q.length < 5 || !/[a-záéíóúñ]/i.test(q)) {
+    return { handled: true, text: missText, estimate: flow };
+  }
+  const items = await resolveAddress(q, owner);
+  if (!items.length) return { handled: true, text: missText, estimate: flow };
+  return acceptAddress(flow, items, language);
+}
+
+function acceptAddress(flow, items, language) {
+  if (items.length === 1) return stepDone(flow, { address: items[0], candidates: [] }, language);
+  const candidates = items.slice(0, MAX_PICKS);
+  const next = { ...flow, data: { ...flow.data, candidates }, step: 'addressPick' };
+  return { handled: true, text: copy(language).addressPick(candidates.map((x) => x.label)), estimate: next };
+}
+
+/* ── Cierre: el MISMO camino que /api/quote/analysis, sin cuenta ni clave ── */
+/* El informe queda protegido por su token de acceso (?t=), igual que el del
+ * wizard: no exige cuenta de cliente. El lead es site-chat (número no
+ * verificado) y arranca en modo conversación: este hilo lo atiende. */
+async function runCompletion({ flow, thread, owner = null, language = 'es' }) {
+  const data = flow && flow.data;
+  if (!data || !data.address) throw new Error('estimate_incomplete');
+  const { lat, lng } = data.address;
+  const customerLeads = require('../../lib/customer-leads');
+  const propertyContext = await require('../../lib/property-context').resolve(lat, lng).catch(() => null);
+  const country = (propertyContext && propertyContext.country) || await geocode.countryForPoint(lat, lng).catch(() => null);
+  const imagery = require('../../lib/aerial').imageryFor(owner, lat, lng);
+  const installerId = (thread && thread.installerId) || (owner && owner.installerId) || null;
+  const created = await customerLeads.create({
+    installerId, source: 'site-chat', address: data.address.label, lat, lng,
+    imagery, newBuild: false, country, propertyContext,
+  });
+  await customerLeads.setContact(created.id, created.access, {
+    name: data.name || (thread && thread.name) || '',
+    email: data.email || '', whatsapp: data.whatsapp || '',
+    followupConsent: true, marketingConsent: false,
+  });
+  await customerLeads.setConversationModeById(created.id, true);
+
+  /* El intake espeja el handler de /api/quote/analysis: la factura se convierte
+   * a kWh con la tarifa del país de la propiedad; sin consumo, la cotización
+   * cae al caso residencial de muestra dentro del techo medido. */
+  const { energyFor } = require('../../data/energy-prices');
+  const PRICING = require('../../lib/pricing');
+  const countryEnergy = country ? energyFor(country) : null;
+  const billCurrency = country && country !== 'AR' ? (countryEnergy && countryEnergy.currency) || 'USD' : 'ARS';
+  const gridPrice = billCurrency === 'ARS' ? PRICING.GRID_PRICE_PER_KWH : Number(countryEnergy && countryEnergy.pricePerKwh) || null;
+  const monthlyBillLocal = data.monthlyBillLocal || null;
+  const monthlyKwh = data.monthlyKwh || (monthlyBillLocal && gridPrice ? Math.round(monthlyBillLocal / gridPrice) : null);
+  const intent = data.intent || 'unsure';
+  const intake = {
+    country: String(country || 'AR').toUpperCase(),
+    monthlyKwh, monthlyBillArs: billCurrency === 'ARS' ? monthlyBillLocal : null, monthlyBillLocal, billCurrency,
+    gridPriceArsPerKwh: billCurrency === 'ARS' ? PRICING.GRID_PRICE_PER_KWH : null, gridPricePerKwh: gridPrice,
+    consumptionSource: monthlyBillLocal ? 'monthly-bill' : 'unknown',
+    intent, intentOther: data.intentOther || '',
+    ownership: data.ownership || 'other', ownershipOther: '',
+    roofEdited: false, phase: 'unknown', roofType: 'unknown', shade: 'unknown',
+    backup: intent === 'save' ? 'none' : intent === 'backup' ? 'full' : 'essential',
+    newBuild: false,
+  };
+  let roofStudy = null;
+  const roofInsights = require('../../lib/roof-insights');
+  const roofVisionEstimator = require('../../lib/roof-vision-estimator');
+  try {
+    roofStudy = await roofInsights.studyFor(lat, lng, { imagery: roofVisionEstimator.normalizeImagery(null), owner });
+  } catch (err) { console.error(`[chat-estimate] roof study: ${err.message}`); }
+  const lead = customerLeads.get(created.id, created.access);
+  const analysis = require('../../lib/quote-analysis').reportAnalysis({ lead, intake, roofStudy });
+  await customerLeads.setAnalysis(created.id, created.access, { intake, analysis, roofStudy });
+
+  const host = String((flow && flow.host) || '').replace(/[^a-z0-9.\-:]/gi, '').split(',')[0] || 'usabruno.com';
+  const resultUrl = `https://${host}/quote/results/${encodeURIComponent(created.id)}?t=${encodeURIComponent(created.access)}`;
+  const plan = (analysis.plans || []).find((p) => p.recommended) || (analysis.plans || [])[0];
+  const { usd, pesos, dec } = require('../../lib/html');
+  const savings = analysis.billCurrency === 'ARS' && analysis.annualKwh && analysis.gridPricePerKwh
+    ? pesos(analysis.annualKwh * analysis.gridPricePerKwh) : null;
+  const summary = copy(language).summary({
+    first: guardrails.firstName(data.name || (thread && thread.name) || ''),
+    address: data.address.label,
+    panels: analysis.panels, kwp: dec(analysis.kwp, 1),
+    plan: plan ? plan.name : '', price: plan ? usd(plan.totalUsd) : '',
+    savings,
+  });
+  return {
+    text: summary,
+    links: [{ label: copy(language).reportLabel, href: resultUrl }],
+    leadId: created.id,
+    estimate: { ...flow, step: 'done', report: { resultUrl } },
+  };
+}
+
+module.exports = { intercept, runCompletion, wantsEstimate, pendingQuestion, copy, stepFor, seedData, parseConsumption, parseOwnership, parseIntent, parseName, parseContact, extractAddressQuery };
