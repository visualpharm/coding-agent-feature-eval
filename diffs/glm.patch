+  if (q.includes('ficticia')) return [{ label: 'Avenida Ficticia 123, Costa de Prueba', lat: -38, lng: -57 }];
+  return [];
+};
+geocode.countryForPoint = async () => 'AR';
+roofInsights.studyFor = async () => null;
+propertyContext.resolve = async () => null;
+
+const server = require('../server/server');
+const store = require('../modules/nimba/store');
+const customerLeads = require('../lib/customer-leads');
+const estimateFlow = require('../modules/nimba/estimate-flow');
+
+test.before(async () => { await new Promise((resolve) => server.listen(0, resolve)); });
+test.after(async () => {
+  await new Promise((resolve) => server.close(resolve));
+  cleanupTestEnv();
+});
+
+const json = (r) => JSON.parse(r.text);
+async function start(body) {
+  const r = await request(server.address().port, { method: 'POST', pathname: '/api/chat/start', json: body });
+  assert.equal(r.status, 200);
+  return json(r);
+}
+async function say(token, text) {
+  const r = await request(server.address().port, { method: 'POST', pathname: '/api/chat/message', json: { token, text } });
+  assert.equal(r.status, 200);
+  return json(r).thread;
+}
+
+test('los abrebocas de precio arrancan el estimador: una pregunta de dirección, nunca una visita ni la lista de planes', async () => {
+  const openers = [
+    ['quiero instalar solar, cuánto sale?', /dirección/i],
+    ['cuánto cuesta poner paneles?', /dirección/i],
+    ['precio para mi casa', /dirección/i],
+    ['quiero paneles', /dirección/i],
+    ['me pasás un presupuesto?', /dirección/i],
+    ['how much for solar?', /address/i],
+    ['i want to install solar, how much?', /address/i],
+  ];
+  for (const [message, question] of openers) {
+    const body = await start({ message });
+    assert.equal(body.thread.messages.length, 2, `${message}: el mensaje y la primera pregunta`);
+    const reply = body.thread.messages[1];
+    assert.equal(reply.dir, 'out');
+    assert.match(reply.text, question, message);
+    assert.doesNotMatch(reply.text, /visita|visit/i, `${message}: sin oferta de visita`);
+    assert.doesNotMatch(reply.text, /USD|US\$/, `${message}: sin precio de referencia`);
+    const stored = store.getForInstaller('demo-installer', body.thread.id);
+    assert.equal(stored.estimate.step, 'address', `${message}: el flujo vive en el hilo`);
+  }
+});
+
+test('camino completo: dirección, dueño, consumo, objetivo, nombre, contacto → informe con link y lead preliminary-ready', async () => {
+  const opened = await start({ message: 'hola, cuánto sale poner paneles?' });
+  const token = opened.token;
+  const steps = [
+    ['Avenida Ficticia 123', /tuya|alquilada|por comprar/i],
+    ['es mía', /consumís/i],
+    ['300 kwh', /ahorrar|respaldo/i],
+    ['ahorrar', /llamás/i],
+    ['Martín', /mail o WhatsApp/i],
+  ];
+  let thread = opened.thread;
+  for (const [answer, next] of steps) {
+    thread = await say(token, answer);
+    assert.match(thread.messages.at(-1).text, next, answer);
+  }
+  assert.equal(store.getForInstaller('demo-installer', thread.id).estimate.step, 'contact');
+  thread = await say(token, 'martin@ejemplo.invalid');
+  const working = thread.messages.at(-2).text;
+  assert.match(working, /armando tu informe/i, 'primero el aviso, después el link');
+  const summary = thread.messages.at(-1);
+  assert.equal(summary.dir, 'out');
+  assert.match(summary.text, /paneles/i);
+  assert.match(summary.text, /kWp/i);
+  assert.match(summary.text, /US\$/);
+  assert.ok((summary.links || []).some((l) => /\/quote\/results\/.+?\?t=/.test(l.href)), 'el link del informe viaja en el mensaje');
+  assert.match(summary.links[0].label, /informe/i);
+
+  const stored = store.getForInstaller('demo-installer', thread.id);
+  assert.equal(stored.estimate.step, 'done');
+  assert.match(stored.estimate.report.resultUrl, /\/quote\/results\//);
+  const lead = customerLeads.getForInstaller('demo-installer', stored.leadId);
+  assert.equal(lead.status, 'preliminary-ready');
+  assert.equal(lead.source, 'site-chat');
+  assert.equal(lead.contact.email, 'martin@ejemplo.invalid');
+  assert.equal(lead.contact.name, 'Martín');
+  assert.equal(lead.intake.monthlyKwh, 300);
+  assert.ok(lead.analysis.panels >= 1, 'la cotización es la del wizard (lib/customer-quote)');
+  assert.ok(lead.analysis.totalUsd > 0 || (lead.analysis.plans || []).length, 'con precios de plan');
+});
+
+test('«no sé» el consumo: cae al caso residencial de muestra, nunca llena el techo porque sí', async () => {
+  const opened = await start({ message: 'cuánto cuesta la energia solar?' });
+  const token = opened.token;
+  let thread = await say(token, 'Avenida Ficticia 123');
+  thread = await say(token, 'es mía');
+  assert.match(thread.messages.at(-1).text, /consumís/i);
+  thread = await say(token, 'no sé');
+  assert.match(thread.messages.at(-1).text, /ahorrar|respaldo/i, 'no sé también avanza');
+  thread = await say(token, 'respaldo ante cortes');
+  thread = await say(token, 'Lucía');
+  thread = await say(token, 'lucia@ejemplo.invalid');
+  const summary = thread.messages.at(-1);
+  assert.match(summary.text, /paneles/i);
+  const stored = store.getForInstaller('demo-installer', thread.id);
+  const lead = customerLeads.getForInstaller('demo-installer', stored.leadId);
+  assert.equal(lead.intake.monthlyKwh, null);
+  assert.equal(lead.intake.consumptionSource, 'unknown');
+  assert.equal(lead.analysis.panels, require('../lib/customer-quote').SAMPLE_HOME_PANELS, 'el caso de muestra publicado');
+});
+
+test('una pregunta ajena a mitad del flujo se contesta y el paso pendiente se repite en el mismo mensaje', async () => {
+  const opened = await start({ message: 'precio para mi casa' });
+  const token = opened.token;
+  let thread = await say(token, 'Avenida Ficticia 123');
+  assert.match(thread.messages.at(-1).text, /tuya|alquilada/i);
+  thread = await say(token, 'cuánto duran las baterías?');
+  const reply = thread.messages.at(-1).text;
+  assert.match(reply, /tuya|alquilada|por comprar/i, 'el paso pendiente se repite pegado');
+  const stored = store.getForInstaller('demo-installer', thread.id);
+  assert.equal(stored.estimate.step, 'ownership', 'el flujo no avanzó con una pregunta ajena');
+});
+
+test('dirección ambigua: lista numerada de a lo sumo 3 y se elige por número', async () => {
+  const opened = await start({ message: 'quiero paneles' });
+  const token = opened.token;
+  let thread = await say(token, 'Calle Falsa 123');
+  const list = thread.messages.at(-1).text;
+  assert.match(list, /1\. Calle Falsa 123, Costa de Prueba/);
+  assert.match(list, /3\. Calle Falsa 123, Costa Norte/);
+  assert.doesNotMatch(list, /Costa Sur/, 'máximo 3 candidatos');
+  assert.equal(store.getForInstaller('demo-installer', thread.id).estimate.step, 'addressPick');
+  thread = await say(token, '2');
+  assert.match(thread.messages.at(-1).text, /tuya|alquilada/i, 'elegió y siguió');
+  const stored = store.getForInstaller('demo-installer', thread.id);
+  assert.equal(stored.estimate.data.address.label, 'Calle Falsa 123, Otra Costa');
+  assert.deepEqual(stored.estimate.data.candidates, []);
+});
+
+test('parsers: kWh, plata («45.000», «45 mil»), nombre y contacto, en ambos idiomas', () => {
+  assert.deepEqual(estimateFlow.parseConsumption('300 kwh'), { monthlyKwh: 300 });
+  assert.deepEqual(estimateFlow.parseConsumption('$45.000'), { monthlyBillLocal: 45000 });
+  assert.deepEqual(estimateFlow.parseConsumption('pago 45 mil'), { monthlyBillLocal: 45000 });
+  assert.deepEqual(estimateFlow.parseConsumption('I pay about $45,000'), { monthlyBillLocal: 45000 });
+  assert.deepEqual(estimateFlow.parseConsumption('no sé'), { unknown: true });
+  assert.deepEqual(estimateFlow.parseConsumption("I don't know"), { unknown: true });
+  assert.equal(estimateFlow.parseName('me llamo martín gómez'), 'Martín Gómez');
+  assert.equal(estimateFlow.parseName('no sé'), null);
+  assert.equal(estimateFlow.parseOwnership('soy el dueño'), 'owner');
+  assert.equal(estimateFlow.parseIntent('ambos').intent, 'other');
+  assert.match(estimateFlow.parseContact('+54 9 11 0000-0000').whatsapp, /^\+54\d{10,}$/);
+  assert.equal(estimateFlow.parseContact('martin@ejemplo.invalid').email, 'martin@ejemplo.invalid');
+});
