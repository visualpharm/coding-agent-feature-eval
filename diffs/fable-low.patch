diff --git a/modules/nimba/estimate-engine.js b/modules/nimba/estimate-engine.js
new file mode 100644
index 0000000..9df9a54
--- /dev/null
+++ b/modules/nimba/estimate-engine.js
@@ -0,0 +1,106 @@
+'use strict';
+/* Las dependencias reales del estimador del chat (estimate.js): el mismo
+ * geocodificador que /api/quote/addresses y el mismo camino de lead + análisis
+ * que /api/quote/contact y /api/quote/analysis, llamando a las libs directo.
+ *
+ * Diferencia deliberada con el wizard: acá NO se crea cuenta de cliente ni se
+ * pide contraseña. El informe queda protegido por el token de acceso del lead
+ * (`?t=`), igual que el link que el wizard manda por mail. La persona puede
+ * crear la cuenta después desde el informe. */
+const customerLeads = require('../../lib/customer-leads');
+const geocode = require('../../lib/geocode');
+const roofInsights = require('../../lib/roof-insights');
+const aerial = require('../../lib/aerial');
+const PRICING = require('../../lib/pricing');
+const { energyFor } = require('../../data/energy-prices');
+const displayCurrency = require('../../lib/display-currency');
+
+function owner(cfg) {
+  if (cfg && cfg.installerId) return cfg;
+  const { whitelabel } = require('../../lib/data-pack');
+  const { acquisitionSite } = require('../../lib/homeowner-routing');
+  return acquisitionSite(whitelabel);
+}
+
+/* server.js exporta reportAnalysis (la única función que cotiza un informe,
+ * la primera vez y en cada re-cotización). Se requiere tarde para no cerrar
+ * un ciclo en el arranque: server → modules → chat-routes → responder. */
+function reportAnalysis(args) { return require('../../server/server').reportAnalysis(args); }
+
+function absoluteUrl(req, pathname) {
+  const host = String((req && req.headers && req.headers.host) || 'usabruno.com').split(',')[0].trim();
+  return `https://${host}${pathname}`;
+}
+
+/* La misma composición de intake que /api/quote/analysis para lo que el chat
+ * sabe: consumo o factura (en la moneda del país de la propiedad), objetivo,
+ * relación con la propiedad. Sin techo editado, sin factura adjunta. */
+function intakeFor({ lead, data }) {
+  const countryEnergy = energyFor(lead.country);
+  const billCurrency = lead.country && lead.country !== 'AR' ? (countryEnergy?.currency || 'USD') : 'ARS';
+  const monthlyBillLocal = Number(data.monthlyBill) > 0 ? Number(data.monthlyBill) : null;
+  const gridPriceLocalPerKwh = billCurrency === 'ARS' ? PRICING.GRID_PRICE_PER_KWH : Number(countryEnergy?.pricePerKwh) || null;
+  const monthlyKwh = Number(data.monthlyKwh) > 0 ? Math.round(Number(data.monthlyKwh))
+    : (monthlyBillLocal && gridPriceLocalPerKwh ? Math.round(monthlyBillLocal / gridPriceLocalPerKwh) : null);
+  const intent = ['save', 'lock', 'backup'].includes(data.intent) ? data.intent : 'unsure';
+  return {
+    country: String(lead.country || 'AR').toUpperCase(),
+    monthlyKwh,
+    monthlyBillArs: billCurrency === 'ARS' ? monthlyBillLocal : null,
+    monthlyBillLocal, billCurrency, sourceBillCurrency: billCurrency,
+    gridPriceArsPerKwh: billCurrency === 'ARS' ? PRICING.GRID_PRICE_PER_KWH : null,
+    gridPricePerKwh: gridPriceLocalPerKwh,
+    consumptionSource: monthlyBillLocal ? 'monthly-bill' : 'unknown',
+    intent, intentOther: '',
+    ownership: ['owner', 'renter', 'planning'].includes(data.ownership) ? data.ownership : 'unsure',
+    ownershipOther: '',
+    roofEdited: false, roofAreaM2: null, roofM2: null, maxSunshineHoursPerYear: null, pitchDegrees: null, panelCount: null,
+    panelShiftEastM: 0, panelShiftNorthM: 0, panelRotationDeg: 0,
+    phase: 'unknown', roofType: 'unknown', shade: 'unknown',
+    backup: intent === 'save' ? 'none' : intent === 'backup' ? 'full' : 'essential',
+    newBuild: data.ownership === 'planning',
+    source: 'site-chat',
+  };
+}
+
+function deps({ req, cfg, thread }) {
+  const site = owner(cfg);
+  return {
+    async geocode(query) {
+      if (!site) throw new Error('no acquisition owner');
+      const bias = await geocode.resolveRequestLocationBias({ req, cfg: site }).catch(() => null);
+      return geocode.searchAddress(query, { cfg: site, bias });
+    },
+    async complete(data) {
+      if (!site) throw new Error('no acquisition owner');
+      const lat = Number(data.lat); const lng = Number(data.lng);
+      const propertyContext = await require('../../lib/property-context').resolve(lat, lng).catch(() => null);
+      const country = propertyContext?.country || await geocode.countryForPoint(lat, lng).catch(() => null);
+      const created = await customerLeads.create({
+        installerId: site.installerId, source: 'site-chat', address: data.address, lat, lng,
+        imagery: aerial.imageryFor(site, lat, lng), newBuild: data.ownership === 'planning', country, propertyContext,
+        simulated: thread.simulated === true,
+      });
+      await customerLeads.setContact(created.id, created.access, {
+        name: data.name, email: data.email || '', whatsapp: data.whatsapp || '',
+        /* Dar el contacto para recibir el informe es el consentimiento de seguimiento. */
+        followupConsent: true, marketingConsent: false,
+      });
+      const lead = customerLeads.get(created.id, created.access);
+      const intake = intakeFor({ lead, data });
+      let roofStudy = null;
+      try { roofStudy = await roofInsights.studyFor(lat, lng, { owner: site }); }
+      catch (err) { console.error(`[roof-insights] ${err.message}`); }
+      const analysis = reportAnalysis({ lead, intake, roofStudy });
+      const updated = await customerLeads.setAnalysis(created.id, created.access, { intake, invoice: null, panelPhoto: null, analysis, roofStudy });
+      const resultPath = `/quote/results/${encodeURIComponent(created.id)}?t=${encodeURIComponent(created.access)}`;
+      const server = require('../../server/server');
+      if (data.email && typeof server.mailQuoteReport === 'function') {
+        await server.mailQuoteReport({ req, owner: site, lead: updated, access: created.access }).catch((err) => console.warn('[chat] report mail failed:', err.message));
+      }
+      return { id: created.id, access: created.access, analysis: updated.analysis, resultUrl: absoluteUrl(req, resultPath) };
+    },
+  };
+}
+
+module.exports = { deps, intakeFor, owner, absoluteUrl };
