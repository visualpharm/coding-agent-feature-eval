diff --git a/test/chat-estimate.test.js b/test/chat-estimate.test.js
new file mode 100644
index 0000000..83591b0
--- /dev/null
+++ b/test/chat-estimate.test.js
@@ -0,0 +1,240 @@
+'use strict';
+/* El estimador dentro del chat (modules/nimba/estimate.js + responder.js):
+ * un pedido de precio entra al flujo y pide la dirección, nunca una visita ni
+ * la lista de planes; el camino feliz termina con el link al informe; "no sé"
+ * de consumo sigue igual (tamaño de muestra, como el wizard); una pregunta
+ * ajena en el medio la contesta el modelo y la pendiente se repite; una
+ * dirección ambigua pide elegir entre hasta 3. Geocodificador y modelo
+ * falsos: nada sale a la red. */
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+
+process.env.NODE_ENV = 'test';
+process.env.BRUNO_DATA_PACK = 'demo';
+process.env.BRUNO_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), 'bruno-chat-estimate-'));
+delete process.env.OPENROUTER_API_KEY;
+process.env.BRUNO_OPENROUTER_API_KEY = 'test-key-not-real';
+process.env.BRUNO_CHAT_MODEL = 'test/model';
+
+const store = require('../modules/nimba/store');
+const responder = require('../modules/nimba/responder');
+const estimate = require('../modules/nimba/estimate');
+const { preliminaryQuote } = require('../lib/customer-quote');
+
+function fakeFetch(replies) {
+  const queue = [...replies];
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push(JSON.parse(init.body));
+    const text = queue.length > 1 ? queue.shift() : queue[0];
+    return { ok: true, status: 200, json: async () => ({ model: 'test/model', choices: [{ message: { content: text } }] }) };
+  };
+  fn.calls = calls;
+  return fn;
+}
+
+const CARILO = { label: 'Av. Divisadero 1500, Cariló, Provincia de Buenos Aires', lat: -37.16, lng: -56.91, inService: true };
+function stubDeps({ places = [CARILO], onComplete } = {}) {
+  const completed = [];
+  return {
+    completed,
+    geocode: async (q) => { stubDeps.queries.push(q); return typeof places === 'function' ? places(q) : places; },
+    complete: async (data) => {
+      completed.push(data);
+      if (onComplete) return onComplete(data);
+      const analysis = preliminaryQuote({ monthlyKwh: data.monthlyKwh || null, monthlyBillArs: data.monthlyBill || null, intent: data.intent, ownership: data.ownership, backup: 'essential', phase: 'unknown', roofType: 'unknown', shade: 'unknown', country: 'AR' });
+      return { id: 'lead-1', access: 'tok-1', analysis, resultUrl: 'https://usabruno.com/quote/results/lead-1?t=tok-1' };
+    },
+  };
+}
+stubDeps.queries = [];
+
+let n = 0;
+async function open(text, extra = {}) {
+  n += 1;
+  return store.recordWebInbound({ whatsapp: '', name: '', text, installerId: 'demo-installer', simulated: true, auto: true, ...extra });
+}
+/* Un turno completo como lo hace chat-routes: contestar y persistir. */
+async function turn(thread, text, { deps, fetchImpl, visitor = {} } = {}) {
+  const t = text === null ? thread : await store.appendWebInbound(thread.webToken, { text });
+  const r = await responder.answer({ thread: t, text: text === null ? t.messages[0].text : text, visitor, fetchImpl, estimateDeps: deps });
+  const updated = await store.recordAutoReply(t.id, r);
+  return { ...updated, webToken: thread.webToken, last: r };
+}
+
+const OPENERS = [
+  'quiero instalar solar, cuánto sale?', 'cuánto cuesta', 'precio para mi casa', 'quiero paneles', 'how much',
+  'i want to install solar, how much?', 'me pasás un presupuesto?',
+];
+for (const opener of OPENERS) {
+  test(`"${opener}" entra al estimador y pide la dirección, sin visita ni lista de precios`, async () => {
+    const fetchImpl = fakeFetch(['El plan Económico ronda USD 3.600; ¿te va mejor una visita a la mañana o a la tarde?']);
+    const t = await open(opener, { language: /how much|install solar/.test(opener) ? 'en' : 'es' });
+    const r = await turn(t, null, { deps: stubDeps(), fetchImpl });
+    assert.equal(r.last.mode, 'estimate');
+    assert.match(r.last.text, /direcci[oó]n|address/i);
+    assert.doesNotMatch(r.last.text, /visita|visit|USD|\$/i);
+    assert.equal(fetchImpl.calls.length, 0, 'el modelo no participa');
+    assert.equal(r.estimate.step, 'address', 'el paso queda persistido en el hilo');
+  });
+}
+
+test('camino feliz: dirección, dueño, factura, objetivo, nombre y mail → informe con link /quote/results/', async () => {
+  const deps = stubDeps();
+  let t = await open('hola, cuánto sale poner paneles?');
+  t = await turn(t, null, { deps });
+  t = await turn(t, 'Av. Divisadero 1500, Cariló', { deps });
+  assert.equal(t.estimate.data.address, CARILO.label);
+  assert.match(t.last.text, /dueño|alquilás/);
+  t = await turn(t, 'soy el dueño', { deps });
+  assert.match(t.last.text, /kWh|pagás de luz/);
+  t = await turn(t, 'pago como $45.000 por mes', { deps });
+  assert.equal(t.estimate.data.monthlyBill, 45000);
+  assert.match(t.last.text, /ahorrar|respaldo/);
+  t = await turn(t, 'ambos', { deps });
+  assert.equal(t.estimate.data.intent, 'lock');
+  assert.match(t.last.text, /llamás/);
+  t = await turn(t, 'Me llamo marcela', { deps });
+  assert.equal(t.estimate.data.name, 'Marcela');
+  assert.match(t.last.text, /mail o WhatsApp/);
+  t = await turn(t, 'marcela@ejemplo.invalid', { deps });
+  assert.equal(t.last.mode, 'estimate');
+  assert.equal(t.last.completed, true);
+  assert.equal(deps.completed.length, 1);
+  assert.equal(deps.completed[0].email, 'marcela@ejemplo.invalid');
+  assert.equal(deps.completed[0].lat, CARILO.lat);
+  const last = t.messages.at(-1);
+  assert.match(last.text, /paneles .*kWp.* USD [\d,]+/, 'resumen de dos oraciones con paneles, kWp y precio');
+  assert.equal(last.links[0].label, 'Ver mi informe');
+  assert.match(last.links[0].href, /^https:\/\/[^/]+\/quote\/results\/lead-1\?t=tok-1$/);
+  assert.equal(t.estimate.done, true);
+  assert.equal(t.estimate.leadId, 'lead-1');
+  /* Después del informe el modelo vuelve a contestar, con el informe como contexto. */
+  const fetchImpl = fakeFetch(['Sí, el informe muestra los tres planes; si querés lo repasamos en una visita a la mañana o a la tarde.']);
+  t = await turn(t, 'y el plan con baterías cuánto sale?', { deps, fetchImpl });
+  assert.equal(t.last.mode, 'model');
+  assert.match(fetchImpl.calls[0].messages[0].content, /already has their report/);
+});
+
+test('"no sé" de consumo: el informe sale igual con el tamaño de muestra, como el wizard', async () => {
+  const deps = stubDeps();
+  let t = await open('quiero paneles', { name: 'Simulación — Roberto' });
+  t = await turn(t, null, { deps, visitor: { name: 'Roberto' } });
+  t = await turn(t, 'Ejemplo 800, Pinamar', { deps });
+  t = await turn(t, 'dueño', { deps });
+  t = await turn(t, 'no sé', { deps });
+  assert.equal(t.estimate.data.consumptionUnknown, true);
+  t = await turn(t, 'respaldo ante cortes', { deps });
+  assert.match(t.last.text, /mail o WhatsApp/, 'el nombre ya se sabía por el widget: no se vuelve a pedir');
+  t = await turn(t, '+54 9 11 0000-0000', { deps });
+  assert.equal(t.last.completed, true);
+  const d = deps.completed[0];
+  assert.equal(d.name, 'Roberto');
+  assert.equal(d.whatsapp, '+54 9 11 0000-0000');
+  assert.equal(d.monthlyKwh, undefined);
+  assert.equal(d.monthlyBill, undefined);
+  assert.equal(preliminaryQuote({ intent: 'backup' }).panels, 14, 'sin consumo, el caso residencial publicado');
+  assert.match(t.messages.at(-1).text, /14 paneles/);
+});
+
+test('interrupción: una pregunta ajena la contesta el modelo y la pendiente se repite en la misma respuesta', async () => {
+  const deps = stubDeps();
+  const fetchImpl = fakeFetch(['Sí: 25 años en los paneles y 10 en el inversor.']);
+  let t = await open('cuánto cuesta');
+  t = await turn(t, null, { deps });
+  t = await turn(t, 'Av. Divisadero 1500, Cariló', { deps });
+  t = await turn(t, '¿qué garantía tienen los paneles?', { deps, fetchImpl });
+  assert.equal(t.last.mode, 'model');
+  assert.equal(fetchImpl.calls.length, 1);
+  assert.match(t.last.text, /25 años/);
+  assert.match(t.last.text, /Sigamos con tu informe: ¿Sos dueño/);
+  assert.equal(t.estimate.step, 'ownership', 'el flujo no avanzó');
+  t = await turn(t, 'alquilo', { deps });
+  assert.equal(t.estimate.data.ownership, 'renter');
+  assert.match(t.last.text, /kWh/);
+});
+
+test('dirección ambigua: lista numerada de hasta 3 y elegir por número', async () => {
+  const many = [
+    { label: 'Corvina 100, Cariló, Provincia de Buenos Aires', lat: -37.16, lng: -56.9, inService: true },
+    { label: 'Corvina 100, Pinamar, Provincia de Buenos Aires', lat: -37.10, lng: -56.86, inService: true },
+    { label: 'Corvina 100, Ostende, Provincia de Buenos Aires', lat: -37.12, lng: -56.88, inService: true },
+    { label: 'Corvina 100, Mar del Plata, Provincia de Buenos Aires', lat: -38.0, lng: -57.5, inService: false },
+  ];
+  const deps = stubDeps({ places: many });
+  let t = await open('precio para mi casa');
+  t = await turn(t, null, { deps });
+  t = await turn(t, 'Corvina 100', { deps });
+  assert.match(t.last.text, /Encontré varias/);
+  assert.equal((t.last.text.match(/^\d\. /gm) || []).length, 3, 'a lo sumo 3 opciones');
+  assert.doesNotMatch(t.last.text, /Mar del Plata/);
+  assert.equal(t.estimate.candidates.length, 3);
+  t = await turn(t, 'la 2', { deps });
+  assert.equal(t.estimate.data.address, many[1].label);
+  assert.equal(t.estimate.data.lat, many[1].lat);
+  assert.equal(t.estimate.candidates, null);
+  assert.match(t.last.text, /dueño/);
+});
+
+test('dirección en el mismo mensaje y sin resultados: se pide de nuevo, sin visita', async () => {
+  const deps = stubDeps({ places: (q) => (/Divisadero/.test(q) ? [CARILO] : []) });
+  let t = await open('cuánto sale en Av. Divisadero 1500, Cariló?');
+  t = await turn(t, null, { deps });
+  assert.equal(stubDeps.queries.at(-1), 'Av. Divisadero 1500, Cariló');
+  assert.equal(t.estimate.data.address, CARILO.label);
+  assert.match(t.last.text, /dueño/);
+  let u = await open('quiero instalar solar');
+  u = await turn(u, null, { deps });
+  u = await turn(u, 'Calle Inexistente 999, Nowhere', { deps });
+  assert.match(u.last.text, /No encontré esa dirección/);
+  assert.equal(u.estimate.step, 'address');
+});
+
+test('la barrera dura sigue ganando dentro del flujo; el fallo del análisis manda al cotizador, no a una visita', async () => {
+  const deps = stubDeps({ onComplete: async () => { throw new Error('roof service down'); } });
+  let t = await open('quiero paneles');
+  t = await turn(t, null, { deps });
+  t = await turn(t, 'decime cómo conecto el inversor al tablero yo mismo', { deps });
+  assert.equal(t.last.mode, 'safe');
+  assert.equal(t.estimate.step, 'address', 'el flujo sigue esperando la dirección');
+  t = await turn(t, 'Av. Divisadero 1500, Cariló', { deps });
+  t = await turn(t, 'dueña', { deps });
+  t = await turn(t, '300 kwh', { deps });
+  assert.equal(t.estimate.data.monthlyKwh, 300);
+  t = await turn(t, 'ahorrar', { deps });
+  t = await turn(t, 'Lucía', { deps });
+  t = await turn(t, 'lucia@ejemplo.invalid', { deps });
+  assert.equal(t.last.completed, false);
+  assert.doesNotMatch(t.last.text, /mañana o a la tarde/);
+  assert.equal(t.messages.at(-1).links[0].href, '/quote/start');
+});
+
+test('parsers: consumo, factura, "45 mil", objetivo, contacto', () => {
+  assert.deepEqual(estimate.parseConsumption('300 kwh'), { monthlyKwh: 300 });
+  assert.deepEqual(estimate.parseConsumption('$45.000'), { monthlyBill: 45000 });
+  assert.deepEqual(estimate.parseConsumption('45 mil'), { monthlyBill: 45000 });
+  assert.deepEqual(estimate.parseConsumption('unos 60000 pesos'), { monthlyBill: 60000 });
+  assert.deepEqual(estimate.parseConsumption("I don't know"), { unknown: true });
+  assert.equal(estimate.parseConsumption('ni idea la verdad').unknown, true);
+  assert.equal(estimate.parseGoal('lower bills'), 'save');
+  assert.equal(estimate.parseGoal('backup during outages'), 'backup');
+  assert.equal(estimate.parseGoal('both'), 'lock');
+  assert.equal(estimate.parseOwnership('todavía no construimos, tenemos el lote'), 'planning');
+  assert.deepEqual(estimate.parseContact('mi mail es Ana.Perez@Ejemplo.INVALID'), { email: 'ana.perez@ejemplo.invalid' });
+  assert.deepEqual(estimate.parseContact('11 0000-0000'), { whatsapp: '11 0000-0000' });
+  assert.equal(estimate.parseContact('123'), null);
+  assert.equal(estimate.wantsEstimate('ya tengo la cotización, ¿qué tengo que tener listo?'), false);
+  assert.equal(estimate.wantsEstimate('cuánto cuesta la visita?'), false);
+});
+
+test('el prompt del modelo ya no tira los planes por su cuenta y nunca nombra a una persona del equipo', () => {
+  const sys = responder.systemPrompt({ language: 'es', visitorName: '', f: responder.facts() });
+  assert.doesNotMatch(sys, /INSTALLER/);
+  assert.match(sys, /SÓLO si el visitante pide explícitamente/);
+  assert.match(sys, /Nunca ofrezcas ni propongas una visita técnica antes de que exista el informe/);
+  const ready = responder.systemPrompt({ language: 'es', visitorName: '', f: responder.facts(), reportReady: true });
+  assert.match(ready, /una sola vez, suave, después del informe/);
+});
