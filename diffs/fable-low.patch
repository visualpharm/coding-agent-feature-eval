+'use strict';
+/* El estimador dentro del chat (Ivan, 2026-09-07, requisitos D.11-12): ante
+ * "cuánto sale" el bot NO ofrece una visita ni tira la lista de planes; pide
+ * los mismos datos que el wizard de /quote/*, uno por mensaje, y termina
+ * mostrando el informe en el hilo. Todo lo que decide acá es determinista:
+ * el modelo de lenguaje no participa del flujo, sólo contesta una pregunta
+ * ajena en el medio (responder.js) y después se repite la pregunta pendiente.
+ *
+ * Estado por hilo: thread.estimate = { step, data, askedAt, ... } (store.js).
+ * Pasos, en orden, saltando los que ya se saben:
+ *   address → ownership → consumption → goal → name → contact → done
+ *
+ * Nada de acá inventa precios: la cotización sale del mismo camino que
+ * /api/quote/analysis (estimate-engine.js → server#reportAnalysis →
+ * lib/customer-quote → lib/pricing + lib/installer-pricing). */
+
+const STEPS = ['address', 'ownership', 'consumption', 'goal', 'name', 'contact'];
+
+/* ── Detección de intención ─────────────────────────────────────────────── */
+const INTENT_RE = [
+  /cu[aá]nto (me )?(sale|cuesta|vale|cobran|saldr[ií]a|costar[ií]a)/i,
+  /\b(precio|presupuesto|cotizaci[oó]n|cotizar|cotizame|cotizarme|costo|valor)\b/i,
+  /\b(quiero|querr[ií]a|quisiera|me interesa|necesito|busco|pensando en) (poner|instalar|comprar|tener|pasar(me)? a)?\s*(paneles|solar|placas|energ[ií]a solar|un sistema|un equipo)/i,
+  /\b(quiero|quisiera|necesito) (paneles|energ[ií]a solar|solar)\b/i,
+  /\b(instalar|poner) (paneles|solar|placas)\b/i,
+  /\bpaneles (solares )?(para|en) (mi|la|una) (casa|techo|propiedad)/i,
+  /how much\b/i,
+  /\b(price|prices|pricing|quote|estimate|cost|costs)\b/i,
+  /\b(want|would like|looking|interested|thinking about|plan(ning)?) (to )?(install|get|buy|put|go)\b.*\b(solar|panels?|system)\b/i,
+  /\binstall(ing)? (solar|panels)\b/i,
+];
+/* Preguntas sobre precios de planes que NO son un pedido de cotización:
+ * "qué incluye el plan", "cuánto cuesta la visita". Se dejan al modelo. */
+const NOT_ESTIMATE_RE = /\b(visita|visit|garant[ií]a|warranty|bater[ií]a sola|solo la bater[ií]a|only the battery)\b/i;
+/* Ya tiene informe/cotización: no es un pedido nuevo. */
+const HAS_QUOTE_RE = /\b(ya (tengo|hice|recib[ií]|termin[eé]|me lleg[oó])|already (have|got|did|finished)|i have my|tengo (mi|el) (informe|presupuesto|cotizaci[oó]n))\b/i;
+
+function wantsEstimate(text) {
+  const t = String(text || '');
+  if (!t.trim()) return false;
+  if (HAS_QUOTE_RE.test(t)) return false;
+  if (NOT_ESTIMATE_RE.test(t) && !/\b(paneles|panels|instalar|install|sistema|system)\b/i.test(t)) return false;
+  return INTENT_RE.some((re) => re.test(t));
+}
+
+/* ── Parsers por paso ───────────────────────────────────────────────────── */
+function parseOwnership(text) {
+  const t = String(text || '').toLowerCase();
+  if (/\b(alquil|inquilin|rent|tenant|lease)/i.test(t)) return 'renter';
+  if (/\b(plane|proyect|constru|terreno|lote|todav[ií]a no|a[uú]n no|planning|building|going to build|lot\b|land\b|not yet)/i.test(t)) return 'planning';
+  if (/\b(due[ñn]|propietari|owner|own\b|m[ií]a\b|m[ií]o\b|propia|propio|es nuestra|es nuestro|mine\b|ours\b)/i.test(t)) return 'owner';
+  if (/^\s*(1|s[ií]|yes|si)\s*[.!]?\s*$/i.test(t)) return 'owner';
+  return null;
+}
+
+const UNKNOWN_RE = /(^|[^\p{L}])(no s[eé]|ni idea|no tengo idea|no lo s[eé]|nose|no estoy segur|no tengo (la )?(factura|idea)|don'?t know|dont know|no idea|not sure|unsure|skip|saltar|pasar)(?![\p{L}])/iu;
+function parseNumber(raw) {
+  let s = String(raw || '').replace(/\s/g, '');
+  /* "45.000" y "45,000" son miles; "1.5" o "2,5" son decimales (poco
+   * probable en kWh/factura, pero no rompe). */
+  if (/^\d{1,3}([.,]\d{3})+$/.test(s)) s = s.replace(/[.,]/g, '');
+  else s = s.replace(',', '.');
+  const n = Number(s);
+  return Number.isFinite(n) ? n : null;
+}
+/* Devuelve { unknown:true } | { monthlyKwh } | { monthlyBill } | null. */
+function parseConsumption(text) {
+  const t = String(text || '').trim();
+  if (UNKNOWN_RE.test(t)) return { unknown: true };
+  const kwh = t.match(/(\d[\d.,]*)\s*(k\s?wh?|kilo\s?watt|kilovatio)/i);
+  if (kwh) { const n = parseNumber(kwh[1]); if (n && n > 0) return { monthlyKwh: Math.round(n) }; }
+  const mil = t.match(/(\d[\d.,]*)\s*(mil|lucas|k)\b/i);
+  if (mil) { const n = parseNumber(mil[1]); if (n && n > 0) return { monthlyBill: Math.round(n * 1000) }; }
+  const money = t.match(/(?:\$|ars|pesos?|usd|u\$s)\s*(\d[\d.,]*)|(\d[\d.,]*)\s*(?:\$|ars|pesos|mangos|dollars?|usd)/i);
+  if (money) { const n = parseNumber(money[1] || money[2]); if (n && n > 0) return { monthlyBill: Math.round(n) }; }
+  const bare = t.match(/(\d[\d.,]*)/);
+  if (bare) {
+    const n = parseNumber(bare[1]);
+    if (n && n > 0) return n >= 2500 ? { monthlyBill: Math.round(n) } : { monthlyKwh: Math.round(n) };
+  }
+  return null;
+}
+
+function parseGoal(text) {
+  const t = String(text || '').toLowerCase();
+  const save = /\b(ahorr|pagar menos|bajar la (factura|boleta)|factura|boleta|save|saving|bill|cheaper|pay less)/i.test(t);
+  const backup = /\b(corte|respaldo|bater|apag[oó]n|sin luz|backup|outage|blackout|power cut|batter)/i.test(t);
+  if (/\b(ambos|ambas|las dos|los dos|todo|both|everything)\b/i.test(t) || (save && backup)) return 'lock';
+  if (backup) return 'backup';
+  if (save) return 'save';
+  if (/^\s*1\s*$/.test(t)) return 'save';
+  if (/^\s*2\s*$/.test(t)) return 'backup';
+  if (/^\s*3\s*$/.test(t)) return 'lock';
+  return null;
+}
+
+function parseName(text) {
+  let t = String(text || '').trim().replace(/[.!]+$/, '');
+  t = t.replace(/^(hola[,!]?\s*)?(me llamo|mi nombre es|soy|my name is|i am|i'm|it's|call me)\s+/i, '');
+  t = t.replace(/[^\p{L}\p{M}' \-]/gu, '').trim();
+  if (!t || t.length < 2 || t.length > 80 || t.split(/\s+/).length > 5) return null;
+  return t.split(/\s+/).map((w) => w[0].toUpperCase() + w.slice(1)).join(' ');
+}
+
+const EMAIL_RE = /[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}/i;
+function parseContact(text) {
+  const t = String(text || '');
+  const email = t.match(EMAIL_RE);
+  if (email) return { email: email[0].toLowerCase() };
+  const digits = t.replace(/[^\d+]/g, '');
+  const bare = digits.replace(/\D/g, '');
+  if (bare.length >= 10 && bare.length <= 15) return { whatsapp: (digits.startsWith('+') ? '+' : '') + bare };
+  return null;
+}
+
+/* ── Copia ──────────────────────────────────────────────────────────────── */
+const COPY = {
+  es: {
+    opener: 'Dale, te armo el informe con paneles en tu techo y precios en un minuto.',
+    address: '¿Cuál es la dirección de la casa? Calle y número, y la localidad.',
+    addressAgain: 'No encontré esa dirección. Escribime calle y número, y la localidad (por ejemplo "Av. Divisadero 1500, Cariló").',
+    addressPick: (items) => `Encontré varias. ¿Cuál es? Contestá con el número.\n${items.map((it, i) => `${i + 1}. ${it.label}`).join('\n')}`,
+    addressPickAgain: 'Contestá 1, 2 o 3, o escribí la dirección más completa.',
+    ownership: '¿Sos dueño, alquilás, o todavía estás por construir?',
+    ownershipAgain: 'Decime si sos dueño, inquilino, o si la casa está en proyecto.',
+    consumption: '¿Cuánto consumís por mes en kWh, o cuánto pagás de luz? Si no sabés, decime "no sé".',
+    consumptionAgain: 'Un número me alcanza: por ejemplo "300 kWh" o "$45.000". Si no sabés, "no sé".',
+    goal: '¿Qué buscás: ahorrar en la factura, respaldo ante cortes, o ambos?',
+    goalAgain: 'Contestá ahorrar, respaldo o ambos.',
+    name: '¿Cómo te llamás?',
+    nameAgain: 'Con tu nombre de pila me alcanza.',
+    contact: '¿A qué mail o WhatsApp te mando el informe?',
+    contactAgain: 'Pasame un mail o un WhatsApp con código de área, por ejemplo +54 9 11 0000-0000.',
+    working: 'Estoy armando tu informe con la foto del techo y los precios…',
+    ready: ({ panels, kwp, plan, priceUsd, annualKwh }) => `Listo: te entran ${panels} paneles (${kwp} kWp) y el plan ${plan} sale ${priceUsd}. Generan unos ${annualKwh} kWh al año; en el informe ves los paneles sobre tu techo, los tres planes y podés cambiar la cantidad.`,
+    readyLink: 'Ver mi informe',
+    failed: 'No pude armar el informe ahora. Probá con el cotizador online, o si querés te lo hacemos nosotros con una visita.',
+    wizardLink: 'Cotizar online',
+    pending: 'Sigamos con tu informe:',
+    outOfService: 'Esa dirección queda fuera de la zona donde instalamos (Cariló, Pinamar, Valeria del Mar, Ostende y Villa Gesell). Si tenés otra propiedad en la zona, pasame esa dirección.',
+  },
+  en: {
+    opener: 'Sure, I will build your report with panels on your roof and prices in about a minute.',
+    address: 'What is the address of the house? Street and number, plus the town.',
+    addressAgain: 'I could not find that address. Send the street and number plus the town (for example "Av. Divisadero 1500, Cariló").',
+    addressPick: (items) => `I found several. Which one is it? Reply with the number.\n${items.map((it, i) => `${i + 1}. ${it.label}`).join('\n')}`,
+    addressPickAgain: 'Reply 1, 2 or 3, or type a more complete address.',
+    ownership: 'Do you own the house, rent it, or are you still planning to build?',
+    ownershipAgain: 'Tell me whether you own, rent, or the house is still a project.',
+    consumption: 'How much do you use per month in kWh, or how much is your electricity bill? If you do not know, say "not sure".',
+    consumptionAgain: 'A number is enough: for example "300 kWh" or "$45,000". If you do not know, say "not sure".',
+    goal: 'What are you after: lower bills, backup during outages, or both?',
+    goalAgain: 'Reply save, backup or both.',
+    name: 'What is your name?',
+    nameAgain: 'Your first name is enough.',
+    contact: 'Which email or WhatsApp should I send the report to?',
+    contactAgain: 'Send an email or a WhatsApp number with area code, for example +54 9 11 0000-0000.',
+    working: 'Building your report with the roof photo and prices…',
+    ready: ({ panels, kwp, plan, priceUsd, annualKwh }) => `Done: ${panels} panels fit (${kwp} kWp) and the ${plan} plan comes to ${priceUsd}. They generate about ${annualKwh} kWh a year; the report shows the panels on your roof, all three plans, and lets you change the count.`,
+    readyLink: 'See my report',
+    failed: 'I could not build the report right now. Try the online estimator, or we can do it for you with a visit.',
+    wizardLink: 'Estimate online',
+    pending: 'Back to your report:',
+    outOfService: 'That address is outside the area we install in (Cariló, Pinamar, Valeria del Mar, Ostende and Villa Gesell). If you have another property in the area, send that address.',
+  },
+};
+const copyFor = (language) => COPY[language] || COPY.en;
+
+/* ── Estado ─────────────────────────────────────────────────────────────── */
+function fresh() { return { step: 'address', data: {}, candidates: null, startedAt: new Date().toISOString(), done: false, leadId: null }; }
+function isActive(thread) { return !!(thread && thread.estimate && !thread.estimate.done && STEPS.includes(thread.estimate.step)); }
+
+const SIMULATION_PREFIX = 'Simulación — ';
+/* Lo que el hilo ya sabe antes de preguntar: nombre del widget, WhatsApp
+ * verificado por el código (nunca el tipeado sin verificar). */
+function known(thread, visitor = {}) {
+  const out = {};
+  const name = String(visitor.name || thread.name || '').replace(SIMULATION_PREFIX, '').trim();
+  if (name) out.name = name;
+  if (thread.verified && thread.whatsapp) out.whatsapp = thread.whatsapp;
+  if (visitor.email && EMAIL_RE.test(visitor.email)) out.email = visitor.email;
+  return out;
+}
+function nextStep(data) {
