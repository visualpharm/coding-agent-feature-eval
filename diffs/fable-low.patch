+      links: [{ label: c.readyLink, href: result.resultUrl }],
+      estimate, handled: true, completed: true,
+    };
+  } catch (err) {
+    console.warn('[chat] estimate completion failed:', err.message);
+    estimate.done = true;
+    estimate.failed = err.message;
+    return { text: prefix + c.failed, links: [{ label: c.wizardLink, href: '/quote/start' }], estimate, handled: true, completed: false };
+  }
+}
